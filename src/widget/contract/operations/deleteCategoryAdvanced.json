        "error": {
          "type": "object|string",
          "description": "Why it was not removed, such as no category having that id."
        },
        "result": {
          "type": "object",
          "description": "The category that was removed.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The category's id."
            },
            "title": {
              "type": "string",
              "description": "The category's title."
            }
          }
        }
      }
    }
