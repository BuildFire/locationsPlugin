{
  "name": "updateLocationFieldValueAdvanced",
  "displayName": "Update location field value",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updateLocationFieldValue",
      "label": "Basic"
    }
  ],
  "context": {
    "functionName": "updateLocationFieldValueAdvanced",
    "hosts": [
      "widgetBackground",
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Fills in one of a location's extra fields, using the location's and the field's ids.",
  "parameters": {
    "locationId": {
      "type": "string",
      "displayName": "Location id",
      "required": true,
      "description": "The location's id, as shown in search results.",
      "sampleValue": "[location id]"
    },
    "fieldId": {
      "type": "string",
      "displayName": "Field id",
      "required": true,
      "description": "The location field's id, as shown in the settings.",
      "sampleValue": "[field id]"
    },
    "newValue": {
      "type": "string",
      "displayName": "Value",
      "required": false,
      "description": "What the location holds for the field, such as an email address, phone number, website or text. Leave it out to keep the current one, or leave it empty to remove it.",
      "sampleValue": "[field value]",
      "nullable": true
    },
    "newCustomLabel": {
      "type": "string",
      "displayName": "Custom label",
      "required": false,
      "description": "The location's own label for the field, where the field allows one. Leave it out to keep the current one, or leave it empty to remove it.",
      "sampleValue": "[field label]",
      "nullable": true
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the value is saved.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't saved, such as no location or field having that id."
        },
        "result": {
          "type": "object",
          "description": "The location, as it is now.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The location's id."
            },
            "title": {
              "type": "string",
              "description": "The location's name."
            },
            "subtitle": {
              "type": "string",
              "description": "The short line shown under its name, if any."
            },
            "address": {
              "type": "string",
              "description": "The location's address."
            },
            "formattedAddress": {
              "type": "string",
              "description": "The full address as the map shows it."
            },
            "addressAlias": {
              "type": "string",
              "description": "The custom name shown for the address, if any."
            },
            "latitude": {
              "type": "number",
              "description": "Where it is on the map, north to south."
            },
            "longitude": {
              "type": "number",
              "description": "Where it is on the map, east to west."
            },
            "listImage": {
              "type": "string",
              "description": "The picture shown for it in lists."
            },
            "description": {
              "type": "string",
              "description": "Its formatted description."
            },
            "images": {
              "type": "array",
              "description": "The pictures on its page, in order.",
              "items": {
                "type": "string",
                "description": "One picture."
              }
            },
            "categories": {
              "type": "string",
              "description": "Its categories and subcategories, written the way they are given when adding a location."
            },
            "categoryTitles": {
              "type": "array",
              "description": "The names of its categories.",
              "items": {
                "type": "string",
                "description": "One category name."
              }
            },
            "subcategoryTitles": {
              "type": "array",
              "description": "The names of its subcategories.",
              "items": {
                "type": "string",
                "description": "One subcategory name."
              }
            },
            "categoryIds": {
              "type": "array",
              "description": "The ids of its categories.",
              "items": {
                "type": "string",
                "description": "A category's id."
              }
            },
            "subcategoryIds": {
              "type": "array",
              "description": "The ids of its subcategories.",
              "items": {
                "type": "string",
                "description": "A subcategory's id."
              }
            },
            "markerType": {
              "type": "string",
              "description": "How it is marked on the map: pin, circle or image."
            },
            "markerImage": {
              "type": "string",
              "description": "The picture used as its marker, if it has one."
            },
            "markerColor": {
              "type": "string",
              "description": "The color of its circle marker, if it has one."
            },
            "showCategory": {
              "type": "boolean",
              "description": "Whether its categories show on its page."
            },
            "showOpeningHours": {
              "type": "boolean",
              "description": "Whether its opening hours show."
            },
            "showPriceRange": {
              "type": "boolean",
              "description": "Whether its price range shows."
            },
            "showStarRating": {
              "type": "boolean",
              "description": "Whether its star rating shows."
            },
            "priceRange": {
              "type": "number",
              "description": "How pricey it is, from 1 ($) to 4 ($$$$)."
            },
            "priceCurrency": {
              "type": "string",
              "description": "The currency sign of its price range."
            },
            "pinned": {
              "type": "boolean",
              "description": "Whether it is pinned to the top of the introduction screen."
            },
            "pinPosition": {
              "type": "number",
              "description": "Its place among the pinned locations, if it is pinned."
            },
            "openingHours": {
              "type": "object",
              "description": "When it is open, day by day.",
              "properties": {
                "monday": {
                  "type": "string",
                  "description": "Its hours on Mondays, such as 08:00-20:00, or closed."
                },
                "tuesday": {
                  "type": "string",
                  "description": "Its hours on Tuesdays, such as 08:00-20:00, or closed."
                },
                "wednesday": {
                  "type": "string",
                  "description": "Its hours on Wednesdays, such as 08:00-20:00, or closed."
                },
                "thursday": {
                  "type": "string",
                  "description": "Its hours on Thursdays, such as 08:00-20:00, or closed."
                },
                "friday": {
                  "type": "string",
                  "description": "Its hours on Fridays, such as 08:00-20:00, or closed."
                },
                "saturday": {
                  "type": "string",
                  "description": "Its hours on Saturdays, such as 08:00-20:00, or closed."
                },
                "sunday": {
                  "type": "string",
                  "description": "Its hours on Sundays, such as 08:00-20:00, or closed."
                }
              }
            },
            "actionItems": {
              "type": "array",
              "description": "The buttons on its page, in order.",
              "items": {
                "type": "object",
                "description": "One button.",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "The button's label."
                  },
                  "action": {
                    "type": "string",
                    "description": "What the button does, such as callNumber or linkToWeb."
                  }
                }
              }
            },
            "fieldValues": {
              "type": "array",
              "description": "What it holds for each location field.",
              "items": {
                "type": "object",
                "description": "One field value.",
                "properties": {
                  "fieldId": {
                    "type": "string",
                    "description": "The location field's id."
                  },
                  "value": {
                    "type": "string",
                    "description": "What the location holds for the field."
                  },
                  "customLabel": {
                    "type": "string",
                    "description": "The location's own label for the field, if it has one."
                  }
                }
              }
            },
            "rating": {
              "type": "object",
              "description": "How app users rated it.",
              "properties": {
                "average": {
                  "type": "number",
                  "description": "Its average rating."
                },
                "count": {
                  "type": "number",
                  "description": "How many ratings it has."
                }
              }
            },
            "views": {
              "type": "number",
              "description": "How many times it was viewed."
            },
            "createdOn": {
              "type": "datetime",
              "description": "When it was added."
            },
            "lastUpdatedOn": {
              "type": "datetime",
              "description": "When it was last changed."
            }
          }
        }
      }
    }
  }
}
