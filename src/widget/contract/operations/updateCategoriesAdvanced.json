{
  "name": "updateCategoriesAdvanced",
  "displayName": "Update categories",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "throttable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API"
  ],
  "context": {
    "functionName": "updateCategoriesAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Changes several categories at once, up to 50.",
  "parameters": {
    "categories": {
      "type": "list",
      "displayName": "Categories",
      "required": true,
      "minValue": 1,
      "maxValue": 50,
      "description": "The changes to make, one per category, up to 50 at a time.",
      "items": {
        "categoryId": {
          "type": "string",
          "displayName": "Category id",
          "required": true,
          "description": "The category's id, as shown in the category list.",
          "sampleValue": "[category id]"
        },
        "newTitle": {
          "type": "string",
          "displayName": "New name",
          "required": false,
          "description": "The category's new title. Leave it out to keep the current one.",
          "sampleValue": "Parks and gardens"
        },
        "newIcon": {
          "type": "image",
          "displayName": "Category icon",
          "required": false,
          "minValue": 1,
          "maxValue": 1,
          "description": "A new picture for the icon, as a list holding one picture. Leave it out to keep the current icon.",
          "sampleValue": [
            "https://example.com/icon.png"
          ]
        },
        "newIconClassName": {
          "type": "string",
          "displayName": "Library icon",
          "required": false,
          "description": "A new icon from the icon library, by its name, instead of a picture. Leave it out to keep the current icon.",
          "sampleValue": "glyphicon glyphicon-tree-deciduous"
        }
      },
      "sampleValue": [
        {
          "categoryId": "[category id]",
          "newTitle": "Parks and gardens"
        }
      ]
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when all the categories are done.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why nothing was changed, such as a category id no one has."
        },
        "result": {
          "type": "object",
          "description": "How each category went.",
          "properties": {
            "categories": {
              "type": "array",
              "description": "One result per category, in the order they were given.",
              "items": {
                "type": "object",
                "description": "How one category went.",
                "properties": {
                  "index": {
                    "type": "number",
                    "description": "Which category this is, counting from 0."
                  },
                  "id": {
                    "type": "string",
                    "description": "The category's id, if it was changed."
                  },
                  "error": {
                    "type": "string",
                    "description": "Why it wasn't changed, if it wasn't."
                  }
                }
              }
            },
            "succeeded": {
              "type": "number",
              "description": "How many were changed."
            },
            "failed": {
              "type": "number",
              "description": "How many were not changed."
            }
          }
        }
      }
    }
  }
}
