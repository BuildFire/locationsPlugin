{
  "name": "updateSubcategoryOrder",
  "displayName": "Reorder subcategory",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updateSubcategoryOrderAdvanced",
      "label": "Advanced"
    }
  ],
  "context": {
    "functionName": "updateSubcategoryOrder",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Moves a subcategory to another place in its category's list, found by their names.",
  "parameters": {
    "category": {
      "type": "string",
      "displayName": "Category name",
      "required": true,
      "description": "The exact name of the category it belongs to.",
      "sampleValue": "[category name]"
    },
    "title": {
      "type": "string",
      "displayName": "Subcategory name",
      "required": true,
      "description": "The exact name of the subcategory to move.",
      "sampleValue": "[subcategory name]"
    },
    "position": {
      "type": "number",
      "displayName": "Position",
      "required": true,
      "minValue": 1,
      "description": "Its new place in its category's list, counting from 1.",
      "sampleValue": 1
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the subcategory is moved.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't moved, such as a place past the end of the list."
        },
        "result": {
          "type": "object",
          "description": "The category, as it is now.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The category's id."
            },
            "title": {
              "type": "string",
              "description": "The category's name."
            },
            "iconUrl": {
              "type": "string",
              "description": "Its picture, if it has one."
            },
            "iconClassName": {
              "type": "string",
              "description": "Its icon from the icon library, if it has one."
            },
            "subcategories": {
              "type": "array",
              "description": "Its subcategories, in order.",
              "items": {
                "type": "object",
                "description": "One subcategory.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The subcategory's id."
                  },
                  "title": {
                    "type": "string",
                    "description": "The subcategory's name."
                  },
                  "iconUrl": {
                    "type": "string",
                    "description": "Its picture, if it has one."
                  },
                  "iconClassName": {
                    "type": "string",
                    "description": "Its icon from the icon library, if it has one."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
