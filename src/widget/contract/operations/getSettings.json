{
  "name": "getSettings",
  "displayName": "Get settings",
  "type": "function",
  "crudMode": "read",
  "flags": [
    "immutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "getSettings",
    "hosts": [
      "widgetBackground",
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Shows the plugin's settings, design and introduction screen.",
  "parameters": {
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the settings are read.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it didn't work, if it didn't."
        },
        "result": {
          "type": "object",
          "description": "The settings.",
          "properties": {
            "subscription": {
              "type": "object",
              "description": "Whether people can subscribe to updates about a location.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether subscribing is on."
                }
              }
            },
            "measurementUnit": {
              "type": "string",
              "description": "The distance units: metric or imperial."
            },
            "introductoryListView": {
              "type": "object",
              "description": "The introduction screen.",
              "properties": {
                "images": {
                  "type": "array",
                  "description": "The pictures at the top of the screen, each with what happens when it is tapped.",
                  "items": {
                    "type": "object",
                    "description": "One picture.",
                    "properties": {
                      "iconUrl": {
                        "type": "string",
                        "description": "The picture."
                      },
                      "action": {
                        "type": "string",
                        "description": "What happens when it is tapped."
                      }
                    }
                  }
                },
                "description": {
                  "type": "string",
                  "description": "The text below the pictures, as formatted text."
                },
                "sorting": {
                  "type": "string",
                  "description": "How its locations are sorted: distance, alphabetical or newest."
                },
                "searchOptions": {
                  "type": "object",
                  "description": "Which locations it lists.",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "description": "Which locations it lists: All, UserPosition, AreaRadius or MyLocations."
                    },
                    "areaRadiusOptions": {
                      "type": "object",
                      "description": "The local area, when only a local area is listed.",
                      "properties": {
                        "formattedLocation": {
                          "type": "string",
                          "description": "The area's center address."
                        },
                        "lat": {
                          "type": "number",
                          "description": "The center's latitude."
                        },
                        "lng": {
                          "type": "number",
                          "description": "The center's longitude."
                        },
                        "radius": {
                          "type": "number",
                          "description": "The radius, in miles."
                        }
                      }
                    }
                  }
                }
              }
            },
            "sorting": {
              "type": "object",
              "description": "How people can sort locations.",
              "properties": {
                "defaultSorting": {
                  "type": "string",
                  "description": "The sort used at first: distance or alphabetical."
                },
                "hideSorting": {
                  "type": "boolean",
                  "description": "Whether sorting is hidden from people."
                },
                "allowSortByReverseAlphabetical": {
                  "type": "boolean",
                  "description": "Whether reverse alphabetical order is offered."
                },
                "allowSortByNearest": {
                  "type": "boolean",
                  "description": "Whether nearest first is offered."
                },
                "allowSortByPriceLowToHigh": {
                  "type": "boolean",
                  "description": "Whether price low to high is offered."
                },
                "allowSortByPriceHighToLow": {
                  "type": "boolean",
                  "description": "Whether price high to low is offered."
                },
                "allowSortByDate": {
                  "type": "boolean",
                  "description": "Whether newest first is offered."
                },
                "allowSortByRating": {
                  "type": "boolean",
                  "description": "Whether by rating is offered."
                },
                "allowSortByViews": {
                  "type": "boolean",
                  "description": "Whether by views is offered."
                }
              }
            },
            "filter": {
              "type": "object",
              "description": "Which filters people can use.",
              "properties": {
                "allowFilterByArea": {
                  "type": "boolean",
                  "description": "Whether filtering by the selected area is offered."
                },
                "allowFilterByBookmarks": {
                  "type": "boolean",
                  "description": "Whether filtering by bookmarks is offered."
                },
                "hideOpeningHoursFilter": {
                  "type": "boolean",
                  "description": "Whether the opening hours filter is hidden."
                },
                "hidePriceFilter": {
                  "type": "boolean",
                  "description": "Whether the price filter is hidden."
                }
              }
            },
            "map": {
              "type": "object",
              "description": "The map.",
              "properties": {
                "initialArea": {
                  "type": "boolean",
                  "description": "Whether the map starts on a chosen area."
                },
                "initialAreaCoordinates": {
                  "type": "object",
                  "description": "The chosen area's center.",
                  "properties": {
                    "lat": {
                      "type": "number",
                      "description": "Its latitude."
                    },
                    "lng": {
                      "type": "number",
                      "description": "Its longitude."
                    }
                  }
                },
                "initialAreaDisplayAddress": {
                  "type": "string",
                  "description": "The chosen area's address."
                }
              }
            },
            "bookmarks": {
              "type": "object",
              "description": "Bookmarks.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether bookmarks are on."
                },
                "allowForLocations": {
                  "type": "boolean",
                  "description": "Whether people can bookmark locations."
                },
                "allowForFilters": {
                  "type": "boolean",
                  "description": "Whether people can bookmark searches."
                }
              }
            },
            "customFields": {
              "type": "object",
              "description": "The location fields every location can fill in.",
              "properties": {
                "quickActions": {
                  "type": "array",
                  "description": "The quick action fields, in order.",
                  "items": {
                    "type": "object",
                    "description": "One field.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The field's id."
                      },
                      "group": {
                        "type": "string",
                        "description": "Where the field is shown: quickActions or content."
                      },
                      "label": {
                        "type": "string",
                        "description": "The field's label."
                      },
                      "type": {
                        "type": "string",
                        "description": "The kind of value the field takes."
                      },
                      "required": {
                        "type": "boolean",
                        "description": "Whether a value is required."
                      },
                      "allowCustomLabel": {
                        "type": "boolean",
                        "description": "Whether each location may give its own label."
                      }
                    }
                  }
                },
                "content": {
                  "type": "array",
                  "description": "The text content fields, in order.",
                  "items": {
                    "type": "object",
                    "description": "One field.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The field's id."
                      },
                      "group": {
                        "type": "string",
                        "description": "Where the field is shown: quickActions or content."
                      },
                      "label": {
                        "type": "string",
                        "description": "The field's label."
                      },
                      "type": {
                        "type": "string",
                        "description": "The kind of value the field takes."
                      },
                      "required": {
                        "type": "boolean",
                        "description": "Whether a value is required."
                      },
                      "allowCustomLabel": {
                        "type": "boolean",
                        "description": "Whether each location may give its own label."
                      }
                    }
                  }
                }
              }
            },
            "design": {
              "type": "object",
              "description": "The look of the plugin.",
              "properties": {
                "listViewPosition": {
                  "type": "string",
                  "description": "Where the list starts: expanded, collapsed or halfExpanded."
                },
                "listViewStyle": {
                  "type": "string",
                  "description": "How list items look: backgroundImage or smallImage."
                },
                "defaultMapType": {
                  "type": "string",
                  "description": "The map type: streets or satellite."
                },
                "detailsMapPosition": {
                  "type": "string",
                  "description": "Where the map sits on a location page: top or bottom."
                },
                "enableMapTerrainView": {
                  "type": "boolean",
                  "description": "Whether the terrain view is on."
                },
                "hideQuickFilter": {
                  "type": "boolean",
                  "description": "Whether the quick filter is hidden."
                },
                "allowStyleSelection": {
                  "type": "boolean",
                  "description": "Whether people can pick the map style."
                },
                "showDetailsCategory": {
                  "type": "boolean",
                  "description": "Whether categories show on a location page."
                },
                "showContributorName": {
                  "type": "boolean",
                  "description": "Whether the name of the person who added a location is shown."
                }
              }
            },
            "globalEntries": {
              "type": "object",
              "description": "Which location details are offered.",
              "properties": {
                "openHours": {
                  "type": "object",
                  "description": "Opening hours.",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "Whether locations have opening hours."
                    }
                  }
                },
                "priceRange": {
                  "type": "object",
                  "description": "Price range.",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "Whether locations have a price range."
                    }
                  }
                },
                "charging": {
                  "type": "object",
                  "description": "Charging for adding locations.",
                  "properties": {
                    "description": {
                      "type": "string",
                      "description": "The payment details shown, as formatted text."
                    }
                  }
                }
              }
            },
            "locationEditors": {
              "type": "object",
              "description": "Location editing.",
              "properties": {
                "time": {
                  "type": "string",
                  "description": "The time format: 12H or 24H."
                }
              }
            }
          }
        }
      }
    }
  }
}
