    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when all the texts are done.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why nothing was changed, such as a text being too long."
        },
        "result": {
          "type": "object",
          "description": "How each text went.",
          "properties": {
            "strings": {
              "type": "array",
              "description": "One result per text, in the order they were given.",
              "items": {
                "type": "object",
                "description": "How one text went.",
                "properties": {
                  "index": {
                    "type": "number",
                    "description": "Which text this is, counting from 0."
                  },
                  "id": {
                    "type": "string",
                    "description": "Which text was changed, if it was."
                  },
                  "error": {
                    "type": "string",
                    "description": "Why it wasn't changed, if it wasn't."
                  }
                }
              }
            },
            "succeeded": {
              "type": "number",
              "description": "How many texts were changed."
            },
            "failed": {
              "type": "number",
              "description": "How many texts weren't changed."
            }
          }
        }
