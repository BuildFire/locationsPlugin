    {
      "name": "searchCategories",
      "displayName": "Search categories",
      "type": "publicData",
      "crudMode": "read",
      "flags": [
        "immutable",
        "safe",
        "unthrottable"
      ],
      "usage": "basic",
      "availableFor": [
        "API",
        "form"
      ],
      "context": {
        "hosts": [
          "widgetBackground",
          "controlBackground",
          "headlessSdk"
        ],
        "collection": "categories",
        "operationType": "search",
        "scope": "app",
        "query": {
          "filter": {
            "_buildfire.index.date1": {
              "$type": 10
            },
            "$json.title": "$params.title"
          },
          "sort": {
            "_buildfire.index.string1": 1
          },
          "page": "$params.page",
          "pageSize": 50,
          "recordCount": true
        }
      },
      "description": "Shows the location categories and their subcategories, by title, 50 at a time.",
      "parameters": [
        "title",
        "page"
      ],
      "definitionPath": "operations/searchCategories.json"
    },
