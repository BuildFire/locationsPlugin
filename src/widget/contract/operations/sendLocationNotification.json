{
  "name": "sendLocationNotification",
  "displayName": "Send location notification",
  "type": "function",
  "crudMode": "create",
  "flags": [
    "mutable",
    "dangerous",
    "throttable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "sendLocationNotificationAdvanced",
      "label": "Advanced"
    }
  ],
  "context": {
    "functionName": "sendLocationNotification",
    "hosts": [
      "widgetForeground",
      "controlForeground",
      "headlessSdk"
    ]
  },
  "description": "No longer available: used to send a push notification about a location to everyone following it.",
  "parameters": {
    "title": {
      "type": "string",
      "displayName": "Location title",
      "required": true,
      "description": "The exact current title of the location, matched ignoring case. A title shared by several locations is refused, naming how many matched.",
      "sampleValue": "[location title]"
    },
    "notificationTitle": {
      "type": "string",
      "displayName": "Notification title",
      "required": true,
      "description": "The notification's title.",
      "sampleValue": "[notification title]"
    },
    "message": {
      "type": "string",
      "displayName": "Message",
      "required": true,
      "description": "The notification's message.",
      "sampleValue": "[notification message]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs right away, saying sending is no longer available.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Always says that sending notifications is no longer available here."
        },
        "result": {
          "type": "object",
          "description": "Nothing is sent any more, so this never comes back.",
          "properties": {
            "sent": {
              "type": "boolean",
              "description": "Always true."
            },
            "recipientCount": {
              "type": "number",
              "description": "How many followers it was sent to."
            },
            "notificationId": {
              "type": "string",
              "description": "The scheduled notification's id, if there is one."
            }
          }
        }
      }
    }
  }
}
