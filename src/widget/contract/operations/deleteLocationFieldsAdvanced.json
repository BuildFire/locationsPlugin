{
  "name": "deleteLocationFieldsAdvanced",
  "displayName": "Delete location fields",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "dangerous",
    "throttable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API"
  ],
  "context": {
    "functionName": "deleteLocationFieldsAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Permanently removes several location fields at once, up to 10.",
  "parameters": {
    "fields": {
      "type": "list",
      "displayName": "Fields",
      "required": true,
      "minValue": 1,
      "maxValue": 10,
      "description": "The fields to remove, up to 10.",
      "items": {
        "fieldId": {
          "type": "string",
          "displayName": "Field id",
          "required": true,
          "description": "The field's id, as shown in the settings."
        }
      },
      "sampleValue": [
        {
          "fieldId": "[field id]"
        }
      ]
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when all the fields are done.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why nothing was removed, such as an unknown field id."
        },
        "result": {
          "type": "object",
          "description": "How each field went.",
          "properties": {
            "fields": {
              "type": "array",
              "description": "One result per field, in the order they were given.",
              "items": {
                "type": "object",
                "description": "How one field went.",
                "properties": {
                  "index": {
                    "type": "number",
                    "description": "Which field this is, counting from 0."
                  },
                  "id": {
                    "type": "string",
                    "description": "The field's id, if it was removed."
                  },
                  "error": {
                    "type": "string",
                    "description": "Why it wasn't removed, if it wasn't."
                  }
                }
              }
            },
            "succeeded": {
              "type": "number",
              "description": "How many were removed."
            },
            "failed": {
              "type": "number",
              "description": "How many weren't removed."
            }
          }
        }
      }
    }
  }
}
