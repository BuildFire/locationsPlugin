{
  "name": "createLocationFieldsAdvanced",
  "displayName": "Create location fields",
  "type": "function",
  "crudMode": "create",
  "flags": [
    "mutable",
    "safe",
    "throttable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API"
  ],
  "context": {
    "functionName": "createLocationFieldsAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Adds several location fields at once, up to 10 in all.",
  "parameters": {
    "fields": {
      "type": "list",
      "displayName": "Fields",
      "required": true,
      "minValue": 1,
      "maxValue": 10,
      "description": "The fields to add, as long as there is room for all of them.",
      "items": {
        "group": {
          "type": "select",
          "displayName": "Field group",
          "required": true,
          "description": "Whether the field is a quick action button or a piece of content on the location screen.",
          "enums": [
            {
              "label": "Quick actions",
              "value": "quickActions"
            },
            {
              "label": "Content",
              "value": "content"
            }
          ],
          "allowEnumCustomOption": false,
          "sampleValue": "content"
        },
        "label": {
          "type": "string",
          "displayName": "Field name",
          "required": true,
          "description": "The field's name, shown on the location screen.",
          "sampleValue": "Email"
        },
        "type": {
          "type": "select",
          "displayName": "Field type",
          "required": true,
          "description": "What the field holds; quick actions take email, phone or URL only.",
          "enums": [
            {
              "label": "Email",
              "value": "EMAIL"
            },
            {
              "label": "Phone",
              "value": "PHONE"
            },
            {
              "label": "URL",
              "value": "URL"
            },
            {
              "label": "Text",
              "value": "TEXT"
            },
            {
              "label": "Rich text",
              "value": "RICH_TEXT"
            }
          ],
          "allowEnumCustomOption": false,
          "sampleValue": "EMAIL"
        },
        "required": {
          "type": "boolean",
          "displayName": "Required",
          "required": false,
          "description": "Whether every location must fill it in. Leave it out for not required.",
          "sampleValue": false
        },
        "enableCustomLabel": {
          "type": "boolean",
          "displayName": "Custom label",
          "required": false,
          "description": "Whether each location can give the field its own label. Leave it out for no.",
          "sampleValue": false
        }
      },
      "sampleValue": [
        {
          "group": "content",
          "label": "Email",
          "type": "EMAIL"
        },
        {
          "group": "quickActions",
          "label": "Call",
          "type": "PHONE"
        }
      ]
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when all the fields are done.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why nothing was added, such as there being no room for them all."
        },
        "result": {
          "type": "object",
          "description": "How each field went.",
          "properties": {
            "fields": {
              "type": "array",
              "description": "One result per field, in the order they were given.",
              "items": {
                "type": "object",
                "description": "How one field went.",
                "properties": {
                  "index": {
                    "type": "number",
                    "description": "Which field this is, counting from 0."
                  },
                  "id": {
                    "type": "string",
                    "description": "The field's id, if it was added."
                  },
                  "error": {
                    "type": "string",
                    "description": "Why it wasn't added, if it wasn't."
                  }
                }
              }
            },
            "succeeded": {
              "type": "number",
              "description": "How many were added."
            },
            "failed": {
              "type": "number",
              "description": "How many were not added."
            }
          }
        }
      }
    }
  }
}
