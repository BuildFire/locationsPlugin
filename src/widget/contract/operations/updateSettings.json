{
  "name": "updateSettings",
  "displayName": "Update settings",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "updateSettings",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Changes the plugin's settings, design and list view, keeping whatever is not given.",
  "parameters": {
    "subscriptionEnabled": {
      "type": "boolean",
      "displayName": "Enable locations subscribing",
      "required": false,
      "description": "Whether people can follow locations to hear about updates. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "distanceUnit": {
      "type": "select",
      "displayName": "Distance units",
      "required": false,
      "description": "How distances are shown. Leave it out to keep the current one.",
      "enums": [
        {
          "label": "Metric",
          "value": "metric"
        },
        {
          "label": "Imperial",
          "value": "imperial"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "metric"
    },
    "timeFormat": {
      "type": "select",
      "displayName": "Time",
      "required": false,
      "description": "How opening hours are shown. Leave it out to keep the current one.",
      "enums": [
        {
          "label": "12 Hours Format",
          "value": "12H"
        },
        {
          "label": "24 Hours Format",
          "value": "24H"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "12H"
    },
    "defaultSorting": {
      "type": "select",
      "displayName": "Default locations sorting",
      "required": false,
      "description": "How locations are first sorted; distance needs nearest-to-user sorting on. Leave it out to keep the current one.",
      "enums": [
        {
          "label": "Distance",
          "value": "distance"
        },
        {
          "label": "Alphabetical",
          "value": "alphabetical"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "alphabetical"
    },
    "hideSorting": {
      "type": "boolean",
      "displayName": "Hide user controlled sorting",
      "required": false,
      "description": "Whether people cannot change the sort. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowSortByReverseAlphabetical": {
      "type": "boolean",
      "displayName": "Allow reverse alphabetical order",
      "required": false,
      "description": "Whether people can sort Z to A. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowSortByNearest": {
      "type": "boolean",
      "displayName": "Nearest to user location",
      "required": false,
      "description": "Whether people can sort by distance; turning it off makes alphabetical the first sort. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowSortByPriceLowToHigh": {
      "type": "boolean",
      "displayName": "Allow price low to high",
      "required": false,
      "description": "Whether people can sort by price, cheapest first. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowSortByPriceHighToLow": {
      "type": "boolean",
      "displayName": "Allow price high to low",
      "required": false,
      "description": "Whether people can sort by price, priciest first. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowSortByDate": {
      "type": "boolean",
      "displayName": "Allow by date (new to old)",
      "required": false,
      "description": "Whether people can sort by newest. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowSortByRating": {
      "type": "boolean",
      "displayName": "Allow by rating",
      "required": false,
      "description": "Whether people can sort by rating. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowSortByViews": {
      "type": "boolean",
      "displayName": "Allow by views",
      "required": false,
      "description": "Whether people can sort by views. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowFilterByArea": {
      "type": "boolean",
      "displayName": "Filter by selected area",
      "required": false,
      "description": "Whether people can narrow the results to an area of the map. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowFilterByBookmarks": {
      "type": "boolean",
      "displayName": "Filter by bookmarks",
      "required": false,
      "description": "Whether people can narrow the results to their bookmarks. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "hideOpeningHoursFilter": {
      "type": "boolean",
      "displayName": "Hide opening hours filter",
      "required": false,
      "description": "Whether the opening hours choice is hidden when narrowing the results. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "hidePriceFilter": {
      "type": "boolean",
      "displayName": "Hide price filter",
      "required": false,
      "description": "Whether the price choice is hidden when narrowing the results. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "mapInitialArea": {
      "type": "boolean",
      "displayName": "Enable map initial area",
      "required": false,
      "description": "Whether the map starts on the area below. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "mapInitialAreaAddress": {
      "type": "string",
      "displayName": "Initial area location",
      "required": false,
      "description": "The address the map starts on. Leave it out to keep the current one.",
      "sampleValue": "San Diego, CA, USA"
    },
    "mapInitialAreaLatitude": {
      "type": "number",
      "displayName": "Initial area latitude",
      "required": false,
      "description": "Where the map starts, north to south. Leave it out to keep the current one.",
      "minValue": -90,
      "maxValue": 90,
      "sampleValue": 32.7157
    },
    "mapInitialAreaLongitude": {
      "type": "number",
      "displayName": "Initial area longitude",
      "required": false,
      "description": "Where the map starts, east to west. Leave it out to keep the current one.",
      "minValue": -180,
      "maxValue": 180,
      "sampleValue": -117.1611
    },
    "bookmarksEnabled": {
      "type": "boolean",
      "displayName": "Enable bookmarks",
      "required": false,
      "description": "Whether bookmarks are on. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowBookmarkLocations": {
      "type": "boolean",
      "displayName": "Allow bookmark location",
      "required": false,
      "description": "Whether people can bookmark locations. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowBookmarkSearches": {
      "type": "boolean",
      "displayName": "Allow bookmark search",
      "required": false,
      "description": "Whether people can bookmark searches. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "listViewPosition": {
      "type": "select",
      "displayName": "List view position",
      "required": false,
      "description": "How far the list view opens. Leave it out to keep the current one.",
      "enums": [
        {
          "label": "Expanded",
          "value": "expanded"
        },
        {
          "label": "Collapsed",
          "value": "collapsed"
        },
        {
          "label": "Half Expanded",
          "value": "halfExpanded"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "collapsed"
    },
    "listViewStyle": {
      "type": "select",
      "displayName": "Default list view style",
      "required": false,
      "description": "How list items look. Leave it out to keep the current one.",
      "enums": [
        {
          "label": "Background Image",
          "value": "backgroundImage"
        },
        {
          "label": "Small Image",
          "value": "smallImage"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "backgroundImage"
    },
    "defaultMapType": {
      "type": "select",
      "displayName": "Default map type",
      "required": false,
      "description": "The map people see first. Leave it out to keep the current one.",
      "enums": [
        {
          "label": "Streets",
          "value": "streets"
        },
        {
          "label": "Satellite",
          "value": "satellite"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "streets"
    },
    "detailsMapPosition": {
      "type": "select",
      "displayName": "Map position",
      "required": false,
      "description": "Where the map sits on the location screen. Leave it out to keep the current one.",
      "enums": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "top"
    },
    "enableMapTerrainView": {
      "type": "boolean",
      "displayName": "Enable map terrain view",
      "required": false,
      "description": "Whether the map shows terrain. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "hideQuickFilter": {
      "type": "boolean",
      "displayName": "Hide quick filter",
      "required": false,
      "description": "Whether the quick category choices above the map are hidden. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "allowMapStyleSelection": {
      "type": "boolean",
      "displayName": "Allow user's map style selection",
      "required": false,
      "description": "Whether people can choose the map style. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "showDetailsCategory": {
      "type": "boolean",
      "displayName": "Show category and subcategory on location details",
      "required": false,
      "description": "Whether the location screen shows categories. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "showContributorName": {
      "type": "boolean",
      "displayName": "Contributor name",
      "required": false,
      "description": "Whether the location screen shows who added the location. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "introImages": {
      "type": "image",
      "displayName": "List view images",
      "required": false,
      "minValue": 0,
      "description": "The pictures at the top of the list view, in order. Replaces the current pictures; leave it out to keep them.",
      "sampleValue": [
        "https://example.com/banner.png"
      ]
    },
    "introDescription": {
      "type": "wysiwyg",
      "displayName": "List view description",
      "required": false,
      "description": "The text above the list, as formatted text. Leave it out to keep it, or leave it empty to remove it.",
      "sampleValue": "<p>[list view description]</p>",
      "nullable": true
    },
    "introVisibility": {
      "type": "select",
      "displayName": "Show list view to",
      "required": false,
      "description": "Who sees the list view; users with tags means those picked in the control panel. Leave it out to keep it as it is.",
      "enums": [
        {
          "label": "All Users",
          "value": "ALL"
        },
        {
          "label": "Users With Tags",
          "value": "TAGS"
        },
        {
          "label": "No Users",
          "value": "NONE"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "ALL"
    },
    "introSorting": {
      "type": "select",
      "displayName": "Sort locations by",
      "required": false,
      "description": "How the list view is sorted. Leave it out to keep the current one.",
      "enums": [
        {
          "label": "Distance",
          "value": "distance"
        },
        {
          "label": "Alphabetical",
          "value": "alphabetical"
        },
        {
          "label": "Newest",
          "value": "newest"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "distance"
    },
    "introLocationsSource": {
      "type": "select",
      "displayName": "Location source",
      "required": false,
      "description": "Which locations the list view shows. Leave it out to keep the current one.",
      "enums": [
        {
          "label": "All Locations",
          "value": "All"
        },
        {
          "label": "User's Position",
          "value": "UserPosition"
        },
        {
          "label": "Local Area",
          "value": "AreaRadius"
        },
        {
          "label": "My Locations",
          "value": "MyLocations"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "UserPosition"
    },
    "introAreaAddress": {
      "type": "string",
      "displayName": "Area center",
      "required": false,
      "description": "The address at the center of the local area. Leave it out to keep the current one.",
      "sampleValue": "San Diego, CA, USA"
    },
    "introAreaLatitude": {
      "type": "number",
      "displayName": "Area center latitude",
      "required": false,
      "description": "The center of the local area, north to south. Leave it out to keep the current one.",
      "minValue": -90,
      "maxValue": 90,
      "sampleValue": 32.7157
    },
    "introAreaLongitude": {
      "type": "number",
      "displayName": "Area center longitude",
      "required": false,
      "description": "The center of the local area, east to west. Leave it out to keep the current one.",
      "minValue": -180,
      "maxValue": 180,
      "sampleValue": -117.1611
    },
    "introAreaRadius": {
      "type": "number",
      "displayName": "Area radius (miles)",
      "required": false,
      "description": "How far the local area reaches, from 1 to 200 miles. Leave it out to keep the current one.",
      "minValue": 1,
      "maxValue": 200,
      "sampleValue": 10
    },
    "openingHoursEnabled": {
      "type": "boolean",
      "displayName": "Open hours",
      "required": false,
      "description": "Whether locations have opening hours; turning it off also hides them from people adding locations. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "priceRangeEnabled": {
      "type": "boolean",
      "displayName": "Price range",
      "required": false,
      "description": "Whether locations have a price range; turning it off also hides it from people adding locations. Leave it out to keep it as it is.",
      "sampleValue": true
    },
    "chargeForNewLocations": {
      "type": "select",
      "displayName": "Charge for adding new locations",
      "required": false,
      "description": "Who pays to add a location in the app; users with tags means those picked in the control panel. Needs adding locations turned on. Leave it out to keep it as it is.",
      "enums": [
        {
          "label": "No Users",
          "value": "none"
        },
        {
          "label": "Users With Tags",
          "value": "limited"
        },
        {
          "label": "All Users",
          "value": "all"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "none"
    },
    "paymentDetails": {
      "type": "wysiwyg",
      "displayName": "Payment details",
      "required": false,
      "description": "What people see before paying to add a location, as formatted text. Leave it out to keep it, or leave it empty to remove it.",
      "sampleValue": "<p>[payment details]</p>",
      "nullable": true
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the settings are saved.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why they were not saved, such as nothing to change or a value not offered."
        },
        "result": {
          "type": "object",
          "description": "The settings.",
          "properties": {
            "subscription": {
              "type": "object",
              "description": "Following locations.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether people can follow locations."
                }
              }
            },
            "measurementUnit": {
              "type": "string",
              "description": "Metric or imperial distances."
            },
            "introductoryListView": {
              "type": "object",
              "description": "The list view.",
              "properties": {
                "images": {
                  "type": "array",
                  "description": "The pictures at the top of the list view.",
                  "items": {
                    "type": "object",
                    "description": "One picture.",
                    "properties": {
                      "iconUrl": {
                        "type": "string",
                        "description": "The picture's address."
                      }
                    }
                  }
                },
                "description": {
                  "type": "string",
                  "description": "The text above the list, as formatted text."
                },
                "sorting": {
                  "type": "string",
                  "description": "How the list is sorted."
                },
                "searchOptions": {
                  "type": "object",
                  "description": "Which locations the list shows.",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "description": "All, the user's position, a local area or the user's own locations."
                    },
                    "areaRadiusOptions": {
                      "type": "object",
                      "description": "The local area.",
                      "properties": {
                        "lat": {
                          "type": "number",
                          "description": "Its center latitude."
                        },
                        "lng": {
                          "type": "number",
                          "description": "Its center longitude."
                        },
                        "radius": {
                          "type": "number",
                          "description": "Its radius in miles."
                        },
                        "formattedLocation": {
                          "type": "string",
                          "description": "Its center address."
                        }
                      }
                    }
                  }
                },
                "visibilityOptions": {
                  "type": "object",
                  "description": "Who sees the list view.",
                  "properties": {
                    "value": {
                      "type": "string",
                      "description": "Everyone, users with tags, or no one."
                    }
                  }
                }
              }
            },
            "sorting": {
              "type": "object",
              "description": "Sorting options.",
              "properties": {
                "defaultSorting": {
                  "type": "string",
                  "description": "The first sort people see."
                },
                "hideSorting": {
                  "type": "boolean",
                  "description": "Whether people cannot change the sort."
                },
                "allowSortByNearest": {
                  "type": "boolean",
                  "description": "Whether people can sort by distance."
                }
              }
            },
            "filter": {
              "type": "object",
              "description": "Ways to narrow the results.",
              "properties": {
                "allowFilterByArea": {
                  "type": "boolean",
                  "description": "Whether people can narrow the results to an area."
                },
                "allowFilterByBookmarks": {
                  "type": "boolean",
                  "description": "Whether people can narrow the results to their bookmarks."
                },
                "hideOpeningHoursFilter": {
                  "type": "boolean",
                  "description": "Whether the opening hours choice is hidden."
                },
                "hidePriceFilter": {
                  "type": "boolean",
                  "description": "Whether the price choice is hidden."
                }
              }
            },
            "map": {
              "type": "object",
              "description": "Map options.",
              "properties": {
                "initialArea": {
                  "type": "boolean",
                  "description": "Whether the map starts on a set area."
                },
                "initialAreaCoordinates": {
                  "type": "object",
                  "description": "Where the map starts.",
                  "properties": {
                    "lat": {
                      "type": "number",
                      "description": "Latitude."
                    },
                    "lng": {
                      "type": "number",
                      "description": "Longitude."
                    }
                  }
                },
                "initialAreaDisplayAddress": {
                  "type": "string",
                  "description": "The address the map starts on."
                }
              }
            },
            "bookmarks": {
              "type": "object",
              "description": "Bookmark options.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether bookmarks are on."
                },
                "allowForLocations": {
                  "type": "boolean",
                  "description": "Whether people can bookmark locations."
                },
                "allowForFilters": {
                  "type": "boolean",
                  "description": "Whether people can bookmark searches."
                }
              }
            },
            "customFields": {
              "type": "object",
              "description": "The location fields.",
              "properties": {
                "quickActions": {
                  "type": "array",
                  "description": "Quick action fields, in order.",
                  "items": {
                    "type": "object",
                    "description": "One field.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The field's id."
                      },
                      "group": {
                        "type": "string",
                        "description": "Quick actions or content."
                      },
                      "label": {
                        "type": "string",
                        "description": "The field's name."
                      },
                      "type": {
                        "type": "string",
                        "description": "What it holds: email, phone, URL, text or rich text."
                      },
                      "required": {
                        "type": "boolean",
                        "description": "Whether every location must fill it in."
                      },
                      "enableCustomLabel": {
                        "type": "boolean",
                        "description": "Whether each location can give it its own label."
                      }
                    }
                  }
                },
                "content": {
                  "type": "array",
                  "description": "Content fields, in order.",
                  "items": {
                    "type": "object",
                    "description": "One field.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The field's id."
                      },
                      "group": {
                        "type": "string",
                        "description": "Quick actions or content."
                      },
                      "label": {
                        "type": "string",
                        "description": "The field's name."
                      },
                      "type": {
                        "type": "string",
                        "description": "What it holds: email, phone, URL, text or rich text."
                      },
                      "required": {
                        "type": "boolean",
                        "description": "Whether every location must fill it in."
                      },
                      "enableCustomLabel": {
                        "type": "boolean",
                        "description": "Whether each location can give it its own label."
                      }
                    }
                  }
                }
              }
            },
            "design": {
              "type": "object",
              "description": "The design.",
              "properties": {
                "listViewPosition": {
                  "type": "string",
                  "description": "How far the list view opens."
                },
                "listViewStyle": {
                  "type": "string",
                  "description": "How list items look."
                },
                "defaultMapType": {
                  "type": "string",
                  "description": "Streets or satellite."
                },
                "detailsMapPosition": {
                  "type": "string",
                  "description": "Where the map sits on the location screen."
                },
                "enableMapTerrainView": {
                  "type": "boolean",
                  "description": "Whether terrain view is on."
                },
                "hideQuickFilter": {
                  "type": "boolean",
                  "description": "Whether the quick category choices are hidden."
                },
                "allowStyleSelection": {
                  "type": "boolean",
                  "description": "Whether people can choose the map style."
                },
                "showDetailsCategory": {
                  "type": "boolean",
                  "description": "Whether the location screen shows categories."
                },
                "showContributorName": {
                  "type": "boolean",
                  "description": "Whether the location screen shows who added it."
                }
              }
            },
            "globalEntries": {
              "type": "object",
              "description": "Location adding options.",
              "properties": {
                "openHours": {
                  "type": "object",
                  "description": "Opening hours.",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "Whether locations have opening hours."
                    }
                  }
                },
                "priceRange": {
                  "type": "object",
                  "description": "Price range.",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "Whether locations have a price range."
                    }
                  }
                },
                "charging": {
                  "type": "object",
                  "description": "Charging for new locations.",
                  "properties": {
                    "enabled": {
                      "type": "string",
                      "description": "No one, users with tags, or everyone."
                    },
                    "description": {
                      "type": "string",
                      "description": "The payment details, as formatted text."
                    }
                  }
                }
              }
            },
            "locationEditors": {
              "type": "object",
              "description": "Time options.",
              "properties": {
                "time": {
                  "type": "string",
                  "description": "12 or 24 hour times."
                }
              }
            }
          }
        }
      }
    }
  }
}
