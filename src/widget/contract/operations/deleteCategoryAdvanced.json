{
  "name": "deleteCategoryAdvanced",
  "displayName": "Delete category",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "deleteCategory",
      "label": "Basic"
    }
  ],
