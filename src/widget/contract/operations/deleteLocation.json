      "sampleValue": "[location title]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the location is removed.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't removed, such as no location having that title."
        },
        "result": {
          "type": "object",
          "description": "The location removed.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The removed location's id."
            }
          }
        }
      }
    }
  }
}
