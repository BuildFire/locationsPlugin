{
  "name": "getSettings",
  "displayName": "Get settings",
  "type": "function",
  "crudMode": "read",
  "flags": [
    "immutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "getSettings",
    "hosts": [
      "widgetBackground",
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Shows this plugin's settings, including the extra location fields.",
  "parameters": {
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the settings are read.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it didn't work, if it didn't."
        },
        "result": {
          "type": "object",
          "description": "The current settings.",
          "properties": {
            "subscription": {
              "type": "object",
              "description": "Following locations.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether app users can follow locations."
                },
                "allowCustomNotifications": {
                  "type": "boolean",
                  "description": "Whether location editors can send notifications to followers."
                }
              }
            },
            "measurementUnit": {
              "type": "string",
              "description": "The distance units: metric or imperial."
            },
            "introductoryListView": {
              "type": "object",
              "description": "The introduction screen.",
              "properties": {
                "images": {
                  "type": "array",
                  "description": "The carousel at the top, in order.",
                  "items": {
                    "type": "object",
                    "description": "One carousel item.",
                    "properties": {
                      "iconUrl": {
                        "type": "string",
                        "description": "The item's picture."
                      },
                      "title": {
                        "type": "string",
                        "description": "The item's title."
                      },
                      "action": {
                        "type": "string",
                        "description": "What tapping it does."
                      }
                    }
                  }
                },
                "description": {
                  "type": "string",
                  "description": "The text below the carousel, as formatted text."
                },
                "sorting": {
                  "type": "string",
                  "description": "How its locations are sorted: distance, alphabetical or newest."
                },
                "searchOptions": {
                  "type": "object",
                  "description": "Which locations it shows.",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "description": "The location source: all, near the user, the local area, or the user's own."
                    },
                    "areaRadiusOptions": {
                      "type": "object",
                      "description": "The local area used when the source is the local area.",
                      "properties": {
                        "lat": {
                          "type": "number",
                          "description": "The area center's latitude."
                        },
                        "lng": {
                          "type": "number",
                          "description": "The area center's longitude."
                        },
                        "formattedLocation": {
                          "type": "string",
                          "description": "The area center's address."
                        },
                        "radius": {
                          "type": "number",
                          "description": "How far around the center, in miles."
                        }
                      }
                    }
                  }
                },
                "visibilityOptions": {
                  "type": "object",
                  "description": "Who sees it.",
                  "properties": {
                    "value": {
                      "type": "string",
                      "description": "None, users with tags, or all."
                    }
                  }
                }
              }
            },
            "sorting": {
              "type": "object",
              "description": "Sorting options.",
              "properties": {
                "defaultSorting": {
                  "type": "string",
                  "description": "How the list is sorted at first: distance or alphabetical."
                },
                "hideSorting": {
                  "type": "boolean",
                  "description": "Whether people cannot change the sorting."
                },
                "allowSortByReverseAlphabetical": {
                  "type": "boolean",
                  "description": "Whether reverse alphabetical order is offered."
                },
                "allowSortByNearest": {
                  "type": "boolean",
                  "description": "Whether nearest first is offered."
                },
                "allowSortByPriceLowToHigh": {
                  "type": "boolean",
                  "description": "Whether price low to high is offered."
                },
                "allowSortByPriceHighToLow": {
                  "type": "boolean",
                  "description": "Whether price high to low is offered."
                },
                "allowSortByDate": {
                  "type": "boolean",
                  "description": "Whether newest first is offered."
                },
                "allowSortByRating": {
                  "type": "boolean",
                  "description": "Whether rating is offered."
                },
                "allowSortByViews": {
                  "type": "boolean",
                  "description": "Whether views is offered."
                }
              }
            },
            "filter": {
              "type": "object",
              "description": "Filtering options.",
              "properties": {
                "allowFilterByArea": {
                  "type": "boolean",
                  "description": "Whether people can narrow the list to an area of the map."
                },
                "allowFilterByBookmarks": {
                  "type": "boolean",
                  "description": "Whether people can narrow the list to their bookmarks."
                },
                "hideOpeningHoursFilter": {
                  "type": "boolean",
                  "description": "Whether the opening hours choice is hidden when people narrow the list."
                },
                "hidePriceFilter": {
                  "type": "boolean",
                  "description": "Whether the price choice is hidden when people narrow the list."
                }
              }
            },
            "map": {
              "type": "object",
              "description": "Map options.",
              "properties": {
                "initialArea": {
                  "type": "boolean",
                  "description": "Whether the map starts on a chosen area."
                },
                "initialAreaCoordinates": {
                  "type": "object",
                  "description": "Where the map starts.",
                  "properties": {
                    "lat": {
                      "type": "number",
                      "description": "The starting point's latitude."
                    },
                    "lng": {
                      "type": "number",
                      "description": "The starting point's longitude."
                    }
                  }
                },
                "initialAreaDisplayAddress": {
                  "type": "string",
                  "description": "The starting point's address."
                }
              }
            },
            "bookmarks": {
              "type": "object",
              "description": "Bookmarks.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether bookmarks are on."
                },
                "allowForLocations": {
                  "type": "boolean",
                  "description": "Whether people can bookmark locations."
                },
                "allowForFilters": {
                  "type": "boolean",
                  "description": "Whether people can bookmark searches."
                }
              }
            },
            "customFields": {
              "type": "object",
              "description": "The extra fields people fill in for a location.",
              "properties": {
                "quickActions": {
                  "type": "array",
                  "description": "The quick action fields, in order.",
                  "items": {
                    "type": "object",
                    "description": "One field.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The field's id."
                      },
                      "label": {
                        "type": "string",
                        "description": "The field's name."
                      },
                      "type": {
                        "type": "string",
                        "description": "What the field holds."
                      },
                      "required": {
                        "type": "boolean",
                        "description": "Whether people must fill it in."
                      },
                      "enableCustomLabel": {
                        "type": "boolean",
                        "description": "Whether people can give it their own label."
                      }
                    }
                  }
                },
                "content": {
                  "type": "array",
                  "description": "The text content fields, in order.",
                  "items": {
                    "type": "object",
                    "description": "One field.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The field's id."
                      },
                      "label": {
                        "type": "string",
                        "description": "The field's name."
                      },
                      "type": {
                        "type": "string",
                        "description": "What the field holds."
                      },
                      "required": {
                        "type": "boolean",
                        "description": "Whether people must fill it in."
                      },
                      "enableCustomLabel": {
                        "type": "boolean",
                        "description": "Whether people can give it their own label."
                      }
                    }
                  }
                }
              }
            },
            "design": {
              "type": "object",
              "description": "How things look.",
              "properties": {
                "listViewPosition": {
                  "type": "string",
                  "description": "Where the list starts: expanded, collapsed or half expanded."
                },
                "listViewStyle": {
                  "type": "string",
                  "description": "The list style: background image or small image."
                },
                "defaultMapType": {
                  "type": "string",
                  "description": "The map type: streets or satellite."
                },
                "enableMapTerrainView": {
                  "type": "boolean",
                  "description": "Whether the terrain view is on."
                },
                "hideQuickFilter": {
                  "type": "boolean",
                  "description": "Whether the quick category buttons above the list are hidden."
                },
                "allowStyleSelection": {
                  "type": "boolean",
                  "description": "Whether people can pick the map style."
                },
                "detailsMapPosition": {
                  "type": "string",
                  "description": "Where the map shows on a location: top or bottom."
                },
                "showDetailsCategory": {
                  "type": "boolean",
                  "description": "Whether categories show on a location."
                },
                "showContributorName": {
                  "type": "boolean",
                  "description": "Whether the contributor's name shows on a location."
                }
              }
            },
            "globalEntries": {
              "type": "object",
              "description": "What app users can add.",
              "properties": {
                "locations": {
                  "type": "object",
                  "description": "Adding new locations.",
                  "properties": {
                    "allowAdding": {
                      "type": "string",
                      "description": "Who it is for: none, users with tags, or all."
                    }
                  }
                },
                "photos": {
                  "type": "object",
                  "description": "Adding photos to locations.",
                  "properties": {
                    "allowAdding": {
                      "type": "string",
                      "description": "Who it is for: none, users with tags, or all."
                    }
                  }
                },
                "openHours": {
                  "type": "object",
                  "description": "Opening hours.",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "Whether locations can have opening hours."
                    },
                    "inAppEnabled": {
                      "type": "string",
                      "description": "Who can set them in the app: none, users with tags, or all."
                    }
                  }
                },
                "priceRange": {
                  "type": "object",
                  "description": "Price range.",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "Whether locations can have a price range."
                    },
                    "inAppEnabled": {
                      "type": "string",
                      "description": "Who can set it in the app: none, users with tags, or all."
                    }
                  }
                },
                "charging": {
                  "type": "object",
                  "description": "Charging for new locations.",
                  "properties": {
                    "enabled": {
                      "type": "string",
                      "description": "Who pays before adding a location: none, users with tags, or all."
                    },
                    "description": {
                      "type": "string",
                      "description": "The payment details people see, as formatted text."
                    }
                  }
                }
              }
            },
            "locationEditors": {
              "type": "object",
              "description": "Location editing.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether chosen people can edit chosen locations."
                },
                "time": {
                  "type": "string",
                  "description": "How opening hours are written: 12H or 24H."
                }
              }
            },
            "lastUpdatedOn": {
              "type": "datetime",
              "description": "When the settings were last changed."
            }
          }
        }
      }
    }
  }
}
