{
  "name": "updateSubcategoryOrderAdvanced",
  "displayName": "Move subcategory",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updateSubcategoryOrder",
      "label": "Basic"
    }
  ],
  "context": {
    "functionName": "updateSubcategoryOrderAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Moves a subcategory to a new place within its category, using the category's and its own id.",
  "parameters": {
    "categoryId": {
      "type": "string",
      "displayName": "Category id",
      "required": true,
      "description": "The category's id, as shown in search results.",
      "sampleValue": "[category id]"
    },
    "subcategoryId": {
      "type": "string",
      "displayName": "Subcategory id",
      "required": true,
      "description": "The subcategory's id, as shown in search results.",
      "sampleValue": "[subcategory id]"
    },
    "position": {
      "type": "number",
      "displayName": "Position",
      "required": true,
      "minValue": 1,
      "description": "Its new place among the category's subcategories, counting from 1.",
      "sampleValue": 1
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the subcategory is moved.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't moved, such as no subcategory having that id."
        },
        "result": {
          "type": "object",
          "description": "The category, with its subcategories in their new order.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The category's id."
            },
            "title": {
              "type": "string",
              "description": "The category's title."
            },
            "iconUrl": {
              "type": "string",
              "description": "The category's icon picture, if it has one."
            },
            "iconClassName": {
              "type": "string",
              "description": "The category's library icon, if it has one."
            },
            "subcategories": {
              "type": "array",
              "description": "Its subcategories, in order.",
              "items": {
                "type": "object",
                "description": "One subcategory.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The subcategory's id."
                  },
                  "title": {
                    "type": "string",
                    "description": "The subcategory's title."
                  },
                  "iconUrl": {
                    "type": "string",
                    "description": "The subcategory's icon picture, if it has one."
                  },
                  "iconClassName": {
                    "type": "string",
                    "description": "The subcategory's library icon, if it has one."
                  }
                }
              }
            },
            "createdOn": {
              "type": "datetime",
              "description": "When it was added."
            },
            "lastUpdatedOn": {
              "type": "datetime",
              "description": "When it was last changed."
            }
          }
        }
      }
    }
  }
}
