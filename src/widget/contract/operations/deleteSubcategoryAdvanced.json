{
  "name": "deleteSubcategoryAdvanced",
  "displayName": "Delete subcategory",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "dangerous",
    "unthrottable"
  ],
  "usage": "advanced",
  "alternatives": [
    {
      "operationName": "deleteSubcategory",
      "label": "Basic"
    }
  ],
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "deleteSubcategoryAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Permanently removes a subcategory from its category, using the category's and the subcategory's ids.",
  "parameters": {
    "categoryId": {
      "type": "string",
      "displayName": "Category id",
      "required": true,
      "description": "The category's id, as shown in search results.",
      "sampleValue": "[category id]"
    },
    "subcategoryId": {
      "type": "string",
      "displayName": "Subcategory id",
      "required": true,
      "description": "The subcategory's id, as shown in the category's search results.",
      "sampleValue": "[subcategory id]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the subcategory is removed.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't removed, such as no subcategory having that id."
        },
        "result": {
          "type": "object",
          "description": "The subcategory that was removed.",
          "properties": {
            "categoryId": {
              "type": "string",
              "description": "The id of the category it belonged to."
            },
            "id": {
              "type": "string",
              "description": "The subcategory's id."
            },
            "title": {
              "type": "string",
              "description": "The subcategory's name."
            },
            "deleted": {
              "type": "boolean",
              "description": "Always yes once it is removed."
            }
          }
        }
      }
    }
  }
}
