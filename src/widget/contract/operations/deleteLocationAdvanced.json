{
  "name": "deleteLocationAdvanced",
  "displayName": "Delete location",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "dangerous",
    "unthrottable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "deleteLocation",
      "label": "Basic"
    }
  ],
