{
  "events": [
    {
      "name": "locationCreated",
      "displayName": "Location Created",
      "description": "Fired after a new location is saved, from the control panel, the app or this contract.",
      "data": [
        "locationId",
        "title"
      ]
    },
    {
      "name": "locationUpdated",
      "displayName": "Location Updated",
      "description": "Fired after a location's details are saved, from the control panel, the app or this contract.",
      "data": [
        "locationId",
        "title"
      ]
    },
    {
      "name": "locationDeleted",
      "displayName": "Location Deleted",
      "description": "Fired after a location is permanently removed.",
      "data": [
        "locationId"
      ]
    },
    {
      "name": "locationSubscribed",
      "displayName": "Location Subscribed",
      "description": "Fired after an app user starts following a location for update notifications.",
      "data": [
        "locationId",
        "userId"
      ]
    },
    {
      "name": "locationUnsubscribed",
      "displayName": "Location Unsubscribed",
      "description": "Fired after an app user stops following a location, whether they chose to or the app removed them.",
      "data": [
        "locationId",
        "userId"
      ]
    },
    {
      "name": "locationBookmarked",
      "displayName": "Location Bookmarked",
      "description": "Fired after an app user bookmarks a location in the app.",
      "data": [
        "locationId",
        "bookmarkId"
      ]
    },
    {
      "name": "locationUnbookmarked",
      "displayName": "Location Unbookmarked",
      "description": "Fired after an app user removes a location bookmark in the app.",
      "data": [
        "locationId",
        "bookmarkId"
      ]
    },
    {
      "name": "locationRated",
      "displayName": "Location Rated",
      "description": "Fired after an app user rates a location and its rating summary is saved.",
      "data": [
        "locationId",
        "average",
        "count"
      ]
    }
