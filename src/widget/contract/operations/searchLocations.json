{
  "name": "searchLocations",
  "displayName": "Search locations",
  "type": "function",
  "crudMode": "read",
  "flags": [
    "immutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "searchLocations",
    "hosts": [
      "widgetBackground",
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Finds locations by text, category or pin, in title order, 50 at a time.",
  "parameters": {
    "searchText": {
      "type": "string",
      "displayName": "Search text",
      "required": false,
      "description": "Only show locations whose title, subtitle or address contains this text. Leave it out to show all.",
      "sampleValue": "[location title]"
    },
    "title": {
      "type": "string",
      "displayName": "Location title",
      "required": false,
      "description": "Only show locations with exactly this title. Leave it out to show all.",
      "sampleValue": "[location title]"
    },
    "categoryTitle": {
      "type": "string",
      "displayName": "Category",
      "required": false,
      "description": "Only show locations in the category with this title. Leave it out to show every category.",
      "sampleValue": "[category title]"
    },
    "subcategoryTitle": {
      "type": "string",
      "displayName": "Subcategory",
      "required": false,
      "description": "Only show locations in the subcategory with this title, within the category given. Leave it out to show every subcategory.",
      "sampleValue": "[subcategory title]"
    },
    "pinnedOnly": {
      "type": "boolean",
      "displayName": "Pinned only",
      "required": false,
      "description": "Only show the locations pinned to the top, in pinned order. Leave it out to show all.",
      "sampleValue": false
    },
    "page": {
      "type": "number",
      "displayName": "Page",
      "required": false,
      "minValue": 0,
      "description": "Which page of 50 to show, counting from 0. Leave it out for the first page.",
      "sampleValue": 0
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the search is done.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it didn't work, such as no category having that title."
        },
        "result": {
          "type": "object",
          "description": "The locations found.",
          "properties": {
            "locations": {
              "type": "array",
              "description": "The locations found, by title.",
              "items": {
                "type": "object",
                "description": "One location.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The location's id."
                  },
                  "title": {
                    "type": "string",
                    "description": "The location's title."
                  },
                  "subtitle": {
                    "type": "string",
                    "description": "The location's subtitle, if it has one."
                  },
                  "address": {
                    "type": "string",
                    "description": "The location's address."
                  },
                  "formattedAddress": {
                    "type": "string",
                    "description": "The full address shown on the map."
                  },
                  "customName": {
                    "type": "string",
                    "description": "The custom name shown for the address, if it has one."
                  },
                  "latitude": {
                    "type": "number",
                    "description": "The location's latitude."
                  },
                  "longitude": {
                    "type": "number",
                    "description": "The location's longitude."
                  },
                  "description": {
                    "type": "string",
                    "description": "The location's description, as formatted text."
                  },
                  "listImage": {
                    "type": "string",
                    "description": "The picture shown for the location in lists."
                  },
                  "images": {
                    "type": "array",
                    "description": "The location's pictures, in order.",
                    "items": {
                      "type": "string",
                      "description": "The address of one picture."
                    }
                  },
                  "categories": {
                    "type": "string",
                    "description": "Its categories, such as Food -> Pizza, Shops."
                  },
                  "categoryIds": {
                    "type": "array",
                    "description": "The ids of the location's categories.",
                    "items": {
                      "type": "string",
                      "description": "A category's id."
                    }
                  },
                  "subcategoryIds": {
                    "type": "array",
                    "description": "The ids of the location's subcategories.",
                    "items": {
                      "type": "string",
                      "description": "A subcategory's id."
                    }
                  },
                  "markerType": {
                    "type": "string",
                    "description": "How the location is marked on the map: pin, circle or image."
                  },
                  "markerImage": {
                    "type": "string",
                    "description": "The picture used as its map marker, if it has one."
                  },
                  "markerColor": {
                    "type": "string",
                    "description": "The color of its circle marker, if it has one."
                  },
                  "showCategory": {
                    "type": "boolean",
                    "description": "Whether its categories are shown."
                  },
                  "showOpeningHours": {
                    "type": "boolean",
                    "description": "Whether its opening hours are shown."
                  },
                  "showPriceRange": {
                    "type": "boolean",
                    "description": "Whether its price range is shown."
                  },
                  "showStarRating": {
                    "type": "boolean",
                    "description": "Whether its star rating is shown."
                  },
                  "priceRange": {
                    "type": "number",
                    "description": "Its price range, from 1 to 4."
                  },
                  "priceCurrency": {
                    "type": "string",
                    "description": "The currency sign shown with its price range."
                  },
                  "openingHours": {
                    "type": "object",
                    "description": "Its opening hours, day by day.",
                    "properties": {
                      "monday": {
                        "type": "string",
                        "description": "Monday's hours, such as 08:00-20:00, or closed."
                      },
                      "tuesday": {
                        "type": "string",
                        "description": "Tuesday's hours, such as 08:00-20:00, or closed."
                      },
                      "wednesday": {
                        "type": "string",
                        "description": "Wednesday's hours, such as 08:00-20:00, or closed."
                      },
                      "thursday": {
                        "type": "string",
                        "description": "Thursday's hours, such as 08:00-20:00, or closed."
                      },
                      "friday": {
                        "type": "string",
                        "description": "Friday's hours, such as 08:00-20:00, or closed."
                      },
                      "saturday": {
                        "type": "string",
                        "description": "Saturday's hours, such as 08:00-20:00, or closed."
                      },
                      "sunday": {
                        "type": "string",
                        "description": "Sunday's hours, such as 08:00-20:00, or closed."
                      }
                    }
                  },
                  "actionItems": {
                    "type": "array",
                    "description": "The location's actions, such as calling or opening a website.",
                    "items": {
                      "type": "object",
                      "description": "One action.",
                      "properties": {
                        "title": {
                          "type": "string",
                          "description": "The action's title."
                        },
                        "action": {
                          "type": "string",
                          "description": "What the action does."
                        }
                      }
                    }
                  },
                  "pinPosition": {
                    "type": "number",
                    "description": "Its place among the locations pinned to the top, from 1 to 3, if it is pinned."
                  },
                  "rating": {
                    "type": "object",
                    "description": "Its star rating.",
                    "properties": {
                      "average": {
                        "type": "number",
                        "description": "The average rating."
                      },
                      "count": {
                        "type": "number",
                        "description": "How many people rated it."
                      }
                    }
                  },
                  "views": {
                    "type": "number",
                    "description": "How many times it was viewed."
                  },
                  "bookmarksCount": {
                    "type": "number",
                    "description": "How many people bookmarked it."
                  },
                  "fields": {
                    "type": "array",
                    "description": "Its values for the plugin's own location fields.",
                    "items": {
                      "type": "object",
                      "description": "One field value.",
                      "properties": {
                        "fieldId": {
                          "type": "string",
                          "description": "The field's id."
                        },
                        "label": {
                          "type": "string",
                          "description": "The field's label."
                        },
                        "value": {
                          "type": "string",
                          "description": "The value given, if any."
                        },
                        "customLabel": {
                          "type": "string",
                          "description": "The custom label given, if any."
                        }
                      }
                    }
                  },
                  "createdOn": {
                    "type": "datetime",
                    "description": "When it was added."
                  },
                  "lastUpdatedOn": {
                    "type": "datetime",
                    "description": "When it was last changed."
                  }
                }
              }
            },
            "total": {
              "type": "number",
              "description": "How many locations match in all."
            },
            "page": {
              "type": "number",
              "description": "The page shown, counting from 0."
            },
            "hasMore": {
              "type": "boolean",
              "description": "Whether there is another page."
            }
          }
        }
      }
    }
  }
}
