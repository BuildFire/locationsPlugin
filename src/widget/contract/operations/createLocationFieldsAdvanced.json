{
  "name": "createLocationFieldsAdvanced",
  "displayName": "Create location fields",
  "type": "function",
  "crudMode": "create",
  "flags": [
    "mutable",
    "safe",
    "throttable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API"
  ],
  "context": {
    "functionName": "createLocationFieldsAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Adds several location fields at once, up to ten in all.",
  "parameters": {
    "fields": {
      "type": "list",
      "displayName": "Location fields",
      "required": true,
      "minValue": 1,
      "maxValue": 10,
      "description": "The fields to add; there can be ten in all.",
      "items": {
        "label": {
          "type": "string",
          "displayName": "Field label",
          "required": true,
          "description": "The field's label, as locations show it.",
          "sampleValue": "[field label]"
        },
        "section": {
          "type": "select",
          "displayName": "Section",
          "required": true,
          "description": "Where the field shows: as a quick action button at the top, or as text content.",
          "enums": [
            {
              "label": "Quick actions",
              "value": "quickActions"
            },
            {
              "label": "Text content",
              "value": "content"
            }
          ],
          "allowEnumCustomOption": false,
          "sampleValue": "content"
        },
        "type": {
          "type": "select",
          "displayName": "Field type",
          "required": true,
          "description": "What the field holds; quick actions hold only an email, phone or URL.",
          "enums": [
            {
              "label": "Email",
              "value": "EMAIL"
            },
            {
              "label": "Phone",
              "value": "PHONE"
            },
            {
              "label": "URL",
              "value": "URL"
            },
            {
              "label": "Text",
              "value": "TEXT"
            },
            {
              "label": "Rich text",
              "value": "RICH_TEXT"
            }
          ],
          "allowEnumCustomOption": false,
          "sampleValue": "URL"
        },
        "required": {
          "type": "boolean",
          "displayName": "Required",
          "required": false,
          "description": "Whether every location must fill it in. Leave it out for not required.",
          "sampleValue": false
        },
        "allowCustomLabel": {
          "type": "boolean",
          "displayName": "Allow custom label",
          "required": false,
          "description": "Whether each location may give it its own label. Leave it out for no.",
          "sampleValue": false
        }
      },
      "sampleValue": [
        {
          "label": "[field label]",
          "section": "content",
          "type": "TEXT"
        }
      ]
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when all the fields are done.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why nothing was added, such as an entry missing what it needs or naming something that doesn't exist."
        },
        "result": {
          "type": "object",
          "description": "How each of the fields went.",
          "properties": {
            "fields": {
              "type": "array",
              "description": "One result per entry, in the order they were given.",
              "items": {
                "type": "object",
                "description": "How one entry went.",
                "properties": {
                  "index": {
                    "type": "number",
                    "description": "Which entry this is, counting from 0."
                  },
                  "id": {
                    "type": "string",
                    "description": "The id of what was added, if it was."
                  },
                  "error": {
                    "type": "string",
                    "description": "Why it wasn't added, if it wasn't."
                  }
                }
              }
            },
            "succeeded": {
              "type": "number",
              "description": "How many were added."
            },
            "failed": {
              "type": "number",
              "description": "How many weren't added."
            }
          }
        }
      }
    }
  }
}
