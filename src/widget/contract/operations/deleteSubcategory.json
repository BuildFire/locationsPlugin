{
  "name": "deleteSubcategory",
  "displayName": "Delete subcategory",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "dangerous",
    "unthrottable"
  ],
  "usage": "basic",
  "alternatives": [
    {
      "operationName": "deleteSubcategoryAdvanced",
      "label": "Advanced"
    }
  ],
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "deleteSubcategory",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Permanently removes a subcategory from its category.",
  "parameters": {
    "categoryTitle": {
      "type": "string",
      "displayName": "Category name",
      "required": true,
      "description": "The name of the category it belongs to.",
      "sampleValue": "[category name]"
    },
    "title": {
      "type": "string",
      "displayName": "Subcategory name",
      "required": true,
      "description": "The name of the subcategory to remove.",
      "sampleValue": "[subcategory name]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the subcategory is removed.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't removed, such as no subcategory having that name."
        },
        "result": {
          "type": "object",
          "description": "The subcategory that was removed.",
          "properties": {
            "categoryId": {
              "type": "string",
              "description": "The id of the category it belonged to."
            },
            "id": {
              "type": "string",
              "description": "The subcategory's id."
            },
            "title": {
              "type": "string",
              "description": "The subcategory's name."
            },
            "deleted": {
              "type": "boolean",
              "description": "Always yes once it is removed."
            }
          }
        }
      }
    }
  }
}
