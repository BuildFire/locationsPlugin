{
  "name": "updateLocationFieldOrder",
  "displayName": "Reorder location field",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updateLocationFieldOrderAdvanced",
      "label": "Advanced"
    }
  ],
  "context": {
    "functionName": "updateLocationFieldOrder",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Moves a location field, found by its label, to another place within its section.",
  "parameters": {
    "label": {
      "type": "string",
      "displayName": "Field label",
      "required": true,
      "description": "The exact label of the field to move.",
      "sampleValue": "[field label]"
    },
    "position": {
      "type": "number",
      "displayName": "Position",
      "required": true,
      "minValue": 1,
      "description": "Its new place within its section, counting from 1.",
      "sampleValue": 1
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the field is moved.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't moved, such as a place past the end of its section."
        },
        "result": {
          "type": "object",
          "description": "The fields of its section, in their new order.",
          "properties": {
            "fields": {
              "type": "array",
              "description": "The fields of its section, in order.",
              "items": {
                "type": "object",
                "description": "One location field.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The field's id."
                  },
                  "label": {
                    "type": "string",
                    "description": "The field's label."
                  },
                  "type": {
                    "type": "string",
                    "description": "What the field holds: EMAIL, PHONE, URL, TEXT or RICH_TEXT."
                  },
                  "section": {
                    "type": "string",
                    "description": "Where it shows: quickActions or content."
                  },
                  "required": {
                    "type": "boolean",
                    "description": "Whether every location must fill it in."
                  },
                  "allowCustomLabel": {
                    "type": "boolean",
                    "description": "Whether each location may give it its own label."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
