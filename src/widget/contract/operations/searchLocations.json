{
  "name": "searchLocations",
  "displayName": "Search locations",
  "type": "function",
  "crudMode": "read",
  "flags": [
    "immutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "searchLocations",
    "hosts": [
      "widgetBackground",
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Shows the locations in this plugin a page at a time, A to Z, narrowed by words, title, category, price or pin.",
  "parameters": {
    "search": {
      "type": "string",
      "displayName": "Search",
      "required": false,
      "description": "Words in the title, subtitle or address. Leave it out to show every location.",
      "sampleValue": "park"
    },
    "title": {
      "type": "string",
      "displayName": "Location title",
      "required": false,
      "description": "Only the location with exactly this title. Leave it out to show every title.",
      "sampleValue": "Balboa Park"
    },
    "categoryName": {
      "type": "string",
      "displayName": "Category",
      "required": false,
      "description": "Only locations in the category with this name. Leave it out to show every category.",
      "sampleValue": "Parks"
    },
    "subcategoryName": {
      "type": "string",
      "displayName": "Subcategory",
      "required": false,
      "description": "Only locations in the subcategory with this name, within the category above. Leave it out to show the whole category.",
      "sampleValue": "Gardens"
    },
    "priceRange": {
      "type": "select",
      "displayName": "Price range",
      "required": false,
      "description": "Only locations with this price range. Leave it out to show every price.",
      "enums": [
        {
          "label": "$",
          "value": 1
        },
        {
          "label": "$$",
          "value": 2
        },
        {
          "label": "$$$",
          "value": 3
        },
        {
          "label": "$$$$",
          "value": 4
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": 2
    },
    "pinnedOnly": {
      "type": "boolean",
      "displayName": "Pinned only",
      "required": false,
      "description": "Only the locations pinned to the top, in their pinned order. Leave it out to show every location.",
      "sampleValue": false
    },
    "sort": {
      "type": "select",
      "displayName": "Sort by",
      "required": false,
      "description": "The order to show them in. Leave it out for A to Z.",
      "enums": [
        {
          "label": "A to Z",
          "value": "alphabetical"
        },
        {
          "label": "Z to A",
          "value": "reverseAlphabetical"
        },
        {
          "label": "Newest first",
          "value": "newest"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "alphabetical"
    },
    "page": {
      "type": "number",
      "displayName": "Page",
      "required": false,
      "description": "Which page to show, counting from 0. Leave it out for the first page.",
      "minValue": 0,
      "sampleValue": 0
    },
    "pageSize": {
      "type": "number",
      "displayName": "Page size",
      "required": false,
      "description": "How many locations a page shows, up to 50. Leave it out for 50.",
      "minValue": 1,
      "maxValue": 50,
      "sampleValue": 50
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the search is done.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it did not work, such as no category having that name."
        },
        "result": {
          "type": "object",
          "description": "The locations that were found.",
          "properties": {
            "locations": {
              "type": "array",
              "description": "The locations on this page.",
              "items": {
                "type": "object",
                "description": "One location.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The location's id."
                  },
                  "title": {
                    "type": "string",
                    "description": "The location's title."
                  },
                  "subtitle": {
                    "type": "string",
                    "description": "The location's subtitle, if it has one."
                  },
                  "address": {
                    "type": "string",
                    "description": "The location's address."
                  },
                  "formattedAddress": {
                    "type": "string",
                    "description": "The full address shown on the map."
                  },
                  "addressAlias": {
                    "type": "string",
                    "description": "The location's custom name, if it has one."
                  },
                  "coordinates": {
                    "type": "object",
                    "description": "Where the location is on the map.",
                    "properties": {
                      "lat": {
                        "type": "number",
                        "description": "Its latitude."
                      },
                      "lng": {
                        "type": "number",
                        "description": "Its longitude."
                      }
                    }
                  },
                  "listImage": {
                    "type": "string",
                    "description": "The picture shown for the location in lists."
                  },
                  "images": {
                    "type": "array",
                    "description": "The location's pictures, in order.",
                    "items": {
                      "type": "object",
                      "description": "One picture.",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "The picture's id."
                        },
                        "imageUrl": {
                          "type": "string",
                          "description": "The picture's address."
                        }
                      }
                    }
                  },
                  "description": {
                    "type": "string",
                    "description": "The location's description, as formatted text."
                  },
                  "categories": {
                    "type": "object",
                    "description": "The categories the location is in.",
                    "properties": {
                      "main": {
                        "type": "array",
                        "description": "The categories' ids.",
                        "items": {
                          "type": "string",
                          "description": "A category's id."
                        }
                      },
                      "subcategories": {
                        "type": "array",
                        "description": "The subcategories' ids.",
                        "items": {
                          "type": "string",
                          "description": "A subcategory's id."
                        }
                      }
                    }
                  },
                  "marker": {
                    "type": "object",
                    "description": "How the location is marked on the map.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "Pin, circle or image."
                      },
                      "image": {
                        "type": "string",
                        "description": "The picture used as an image marker, if any."
                      },
                      "color": {
                        "type": "object",
                        "description": "The circle marker's color, if any.",
                        "properties": {
                          "color": {
                            "type": "string",
                            "description": "The color."
                          }
                        }
                      }
                    }
                  },
                  "settings": {
                    "type": "object",
                    "description": "What the location screen shows.",
                    "properties": {
                      "showCategory": {
                        "type": "boolean",
                        "description": "Whether its categories are shown."
                      },
                      "showOpeningHours": {
                        "type": "boolean",
                        "description": "Whether its opening hours are shown."
                      },
                      "showPriceRange": {
                        "type": "boolean",
                        "description": "Whether its price range is shown."
                      },
                      "showStarRating": {
                        "type": "boolean",
                        "description": "Whether its star rating is shown."
                      }
                    }
                  },
                  "price": {
                    "type": "object",
                    "description": "The location's price range.",
                    "properties": {
                      "range": {
                        "type": "number",
                        "description": "From 1 ($) to 4 ($$$$)."
                      },
                      "currency": {
                        "type": "string",
                        "description": "The currency sign."
                      }
                    }
                  },
                  "openingHours": {
                    "type": "object",
                    "description": "When the location is open.",
                    "properties": {
                      "days": {
                        "type": "object",
                        "description": "Each day of the week, by name.",
                        "properties": {
                          "monday": {
                            "type": "object",
                            "description": "Monday's hours.",
                            "properties": {
                              "active": {
                                "type": "boolean",
                                "description": "Whether it is open that day."
                              },
                              "intervals": {
                                "type": "array",
                                "description": "The times it is open.",
                                "items": {
                                  "type": "object",
                                  "description": "One opening time.",
                                  "properties": {
                                    "from": {
                                      "type": "datetime",
                                      "description": "When it opens, on 1 January 1970."
                                    },
                                    "to": {
                                      "type": "datetime",
                                      "description": "When it closes, on 1 January 1970."
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "tuesday": {
                            "type": "object",
                            "description": "Tuesday's hours.",
                            "properties": {
                              "active": {
                                "type": "boolean",
                                "description": "Whether it is open that day."
                              },
                              "intervals": {
                                "type": "array",
                                "description": "The times it is open.",
                                "items": {
                                  "type": "object",
                                  "description": "One opening time.",
                                  "properties": {
                                    "from": {
                                      "type": "datetime",
                                      "description": "When it opens, on 1 January 1970."
                                    },
                                    "to": {
                                      "type": "datetime",
                                      "description": "When it closes, on 1 January 1970."
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "wednesday": {
                            "type": "object",
                            "description": "Wednesday's hours.",
                            "properties": {
                              "active": {
                                "type": "boolean",
                                "description": "Whether it is open that day."
                              },
                              "intervals": {
                                "type": "array",
                                "description": "The times it is open.",
                                "items": {
                                  "type": "object",
                                  "description": "One opening time.",
                                  "properties": {
                                    "from": {
                                      "type": "datetime",
                                      "description": "When it opens, on 1 January 1970."
                                    },
                                    "to": {
                                      "type": "datetime",
                                      "description": "When it closes, on 1 January 1970."
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "thursday": {
                            "type": "object",
                            "description": "Thursday's hours.",
                            "properties": {
                              "active": {
                                "type": "boolean",
                                "description": "Whether it is open that day."
                              },
                              "intervals": {
                                "type": "array",
                                "description": "The times it is open.",
                                "items": {
                                  "type": "object",
                                  "description": "One opening time.",
                                  "properties": {
                                    "from": {
                                      "type": "datetime",
                                      "description": "When it opens, on 1 January 1970."
                                    },
                                    "to": {
                                      "type": "datetime",
                                      "description": "When it closes, on 1 January 1970."
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "friday": {
                            "type": "object",
                            "description": "Friday's hours.",
                            "properties": {
                              "active": {
                                "type": "boolean",
                                "description": "Whether it is open that day."
                              },
                              "intervals": {
                                "type": "array",
                                "description": "The times it is open.",
                                "items": {
                                  "type": "object",
                                  "description": "One opening time.",
                                  "properties": {
                                    "from": {
                                      "type": "datetime",
                                      "description": "When it opens, on 1 January 1970."
                                    },
                                    "to": {
                                      "type": "datetime",
                                      "description": "When it closes, on 1 January 1970."
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "saturday": {
                            "type": "object",
                            "description": "Saturday's hours.",
                            "properties": {
                              "active": {
                                "type": "boolean",
                                "description": "Whether it is open that day."
                              },
                              "intervals": {
                                "type": "array",
                                "description": "The times it is open.",
                                "items": {
                                  "type": "object",
                                  "description": "One opening time.",
                                  "properties": {
                                    "from": {
                                      "type": "datetime",
                                      "description": "When it opens, on 1 January 1970."
                                    },
                                    "to": {
                                      "type": "datetime",
                                      "description": "When it closes, on 1 January 1970."
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "sunday": {
                            "type": "object",
                            "description": "Sunday's hours.",
                            "properties": {
                              "active": {
                                "type": "boolean",
                                "description": "Whether it is open that day."
                              },
                              "intervals": {
                                "type": "array",
                                "description": "The times it is open.",
                                "items": {
                                  "type": "object",
                                  "description": "One opening time.",
                                  "properties": {
                                    "from": {
                                      "type": "datetime",
                                      "description": "When it opens, on 1 January 1970."
                                    },
                                    "to": {
                                      "type": "datetime",
                                      "description": "When it closes, on 1 January 1970."
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "pinIndex": {
                    "type": "number",
                    "description": "Its place among the pinned locations, if it is pinned."
                  },
                  "actionItems": {
                    "type": "array",
                    "description": "The location's buttons, such as a phone call or a website.",
                    "items": {
                      "type": "object",
                      "description": "One button.",
                      "properties": {
                        "title": {
                          "type": "string",
                          "description": "The button's text."
                        },
                        "action": {
                          "type": "string",
                          "description": "What it does."
                        }
                      }
                    }
                  },
                  "additionalFields": {
                    "type": "object",
                    "description": "The location's values for the location fields.",
                    "properties": {
                      "quickActions": {
                        "type": "array",
                        "description": "Values of the quick action fields.",
                        "items": {
                          "type": "object",
                          "description": "One value.",
                          "properties": {
                            "id": {
                              "type": "string",
                              "description": "The field's id."
                            },
                            "customLabel": {
                              "type": "string",
                              "description": "The custom label, if any."
                            },
                            "value": {
                              "type": "string",
                              "description": "The value, if any."
                            }
                          }
                        }
                      },
                      "content": {
                        "type": "array",
                        "description": "Values of the content fields.",
                        "items": {
                          "type": "object",
                          "description": "One value.",
                          "properties": {
                            "id": {
                              "type": "string",
                              "description": "The field's id."
                            },
                            "customLabel": {
                              "type": "string",
                              "description": "The custom label, if any."
                            },
                            "value": {
                              "type": "string",
                              "description": "The value, if any."
                            }
                          }
                        }
                      }
                    }
                  },
                  "views": {
                    "type": "number",
                    "description": "How many times it was viewed."
                  },
                  "rating": {
                    "type": "object",
                    "description": "The location's star rating.",
                    "properties": {
                      "average": {
                        "type": "number",
                        "description": "The average rating."
                      },
                      "count": {
                        "type": "number",
                        "description": "How many ratings it has."
                      }
                    }
                  },
                  "createdOn": {
                    "type": "datetime",
                    "description": "When it was added."
                  },
                  "createdBy": {
                    "type": "object",
                    "description": "Who added it, if known.",
                    "properties": {
                      "_id": {
                        "type": "string",
                        "description": "Their id."
                      },
                      "displayName": {
                        "type": "string",
                        "description": "Their name."
                      }
                    }
                  },
                  "lastUpdatedOn": {
                    "type": "datetime",
                    "description": "When it was last changed."
                  },
                  "lastUpdatedBy": {
                    "type": "object",
                    "description": "Who last changed it, if known.",
                    "properties": {
                      "_id": {
                        "type": "string",
                        "description": "Their id."
                      },
                      "displayName": {
                        "type": "string",
                        "description": "Their name."
                      }
                    }
                  }
                }
              }
            },
            "total": {
              "type": "number",
              "description": "How many locations match in all."
            },
            "page": {
              "type": "number",
              "description": "Which page this is, counting from 0."
            },
            "hasMore": {
              "type": "boolean",
              "description": "Whether another page follows."
            }
          }
        }
      }
    }
  }
}
