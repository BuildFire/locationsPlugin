{
  "name": "deleteLocationSubscriber",
  "displayName": "Delete location subscriber",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "deleteLocationSubscriberAdvanced",
      "label": "Advanced"
    }
  ],
  "context": {
    "functionName": "deleteLocationSubscriber",
    "hosts": [
      "widgetBackground",
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Stops a person from getting update notifications about a location, on behalf of the app.",
  "parameters": {
    "title": {
      "type": "string",
      "displayName": "Location title",
      "required": true,
      "description": "The exact current title of the location, matched ignoring case. A title shared by several locations is refused, naming how many matched.",
      "sampleValue": "[location title]"
    },
    "userId": {
      "type": "user",
      "displayName": "App user",
      "required": true,
      "description": "The app user whose updates are stopped, by user id or email; the only user named.",
      "sampleValue": "[user id]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when it's done, with the removal.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it didn't work, such as when the location can't be found or is ambiguous, or that user isn't following it."
        },
        "result": {
          "type": "object",
          "description": "What was removed.",
          "properties": {
            "removed": {
              "type": "boolean",
              "description": "Always true."
            },
            "locationId": {
              "type": "string",
              "description": "The location's id."
            },
            "userId": {
              "type": "string",
              "description": "The user's id."
            }
          }
        }
      }
    }
  }
}
