{
  "name": "createSubcategory",
  "displayName": "Create subcategory",
  "type": "function",
  "crudMode": "create",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "createSubcategoryAdvanced",
      "label": "Advanced"
    }
  ],
  "context": {
    "functionName": "createSubcategory",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Adds a subcategory at the end of a category, found by its title.",
  "parameters": {
    "categoryTitle": {
      "type": "string",
      "displayName": "Category name",
      "required": true,
      "description": "The exact title of the category the subcategory is in.",
      "sampleValue": "Parks"
    },
    "title": {
      "type": "string",
      "displayName": "Subcategory name",
      "required": true,
      "description": "The new subcategory's title.",
      "sampleValue": "Gardens"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the subcategory is added.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it was not added, such as no category having that title."
        },
        "result": {
          "type": "object",
          "description": "The new subcategory.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The subcategory's id."
            },
            "title": {
              "type": "string",
              "description": "The subcategory's title."
            },
            "iconUrl": {
              "type": "string",
              "description": "The subcategory's icon picture, if any."
            },
            "iconClassName": {
              "type": "string",
              "description": "The subcategory's icon from the icon library, if any."
            },
            "categoryId": {
              "type": "string",
              "description": "Its category's id."
            },
            "categoryTitle": {
              "type": "string",
              "description": "Its category's title."
            }
          }
        }
      }
    }
  }
}
