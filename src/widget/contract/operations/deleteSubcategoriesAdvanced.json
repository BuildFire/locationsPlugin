{
  "name": "deleteSubcategoriesAdvanced",
  "displayName": "Delete subcategories",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "dangerous",
    "throttable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API"
  ],
  "context": {
    "functionName": "deleteSubcategoriesAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Permanently removes several subcategories at once.",
  "parameters": {
    "subcategories": {
      "type": "list",
      "displayName": "Subcategories",
      "required": true,
      "minValue": 1,
      "maxValue": 50,
      "items": {
        "categoryId": {
          "type": "string",
          "displayName": "Category id",
          "required": true,
          "description": "The category's id, as shown in category search results."
        },
        "subcategoryId": {
          "type": "string",
          "displayName": "Subcategory id",
          "required": true,
          "description": "The subcategory's id, as the category search gives it."
        }
      },
      "description": "The subcategories to remove, up to 50 per call.",
      "sampleValue": [
        {
          "categoryId": "[category id]",
          "subcategoryId": "[subcategory id]"
        }
      ]
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when it's done, with each subcategory's outcome.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it didn't work, such as when any entry does not resolve or repeats one, in which case nothing is removed."
        },
        "result": {
          "type": "object",
          "description": "What was removed.",
          "properties": {
            "subcategories": {
              "type": "array",
              "description": "One outcome per input entry, in input order.",
              "items": {
                "type": "object",
                "description": "One entry's outcome.",
                "properties": {
                  "index": {
                    "type": "number",
                    "description": "The entry's position in the input list, from 0."
                  },
                  "id": {
                    "type": "string",
                    "description": "The subcategory's id, if it worked."
                  },
                  "error": {
                    "type": "string",
                    "description": "Why the entry failed, if it didn't."
                  }
                }
              }
            },
            "succeeded": {
              "type": "number",
              "description": "How many entries succeeded."
            },
            "failed": {
              "type": "number",
              "description": "How many entries failed."
            }
          }
        }
      }
    }
  }
}
