{
  "name": "updateLocationFieldOrderAdvanced",
  "displayName": "Reorder location field",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "advanced",
  "alternatives": [
    {
      "operationName": "updateLocationFieldOrder",
      "label": "Basic"
    }
  ],
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "updateLocationFieldOrderAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Moves an extra location field to a new place within its section, using the field's id.",
  "parameters": {
    "fieldId": {
      "type": "string",
      "displayName": "Field id",
      "required": true,
      "description": "The field's id, as shown in the settings.",
      "sampleValue": "[field id]"
    },
    "position": {
      "type": "number",
      "displayName": "Position",
      "required": true,
      "minValue": 1,
      "description": "Where the field goes in its section, counting from 1.",
      "sampleValue": 1
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the field is moved.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't moved, such as no field having that id."
        },
        "result": {
          "type": "object",
          "description": "The fields of that section in their new order.",
          "properties": {
            "section": {
              "type": "string",
              "description": "The section the field is in."
            },
            "fields": {
              "type": "array",
              "description": "The fields of that section, in their new order.",
              "items": {
                "type": "object",
                "description": "One field.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The field's id."
                  },
                  "label": {
                    "type": "string",
                    "description": "The field's name."
                  },
                  "section": {
                    "type": "string",
                    "description": "Where the field shows: quick actions or text content."
                  },
                  "type": {
                    "type": "string",
                    "description": "What the field holds, such as an email, a phone number or text."
                  },
                  "required": {
                    "type": "boolean",
                    "description": "Whether people must fill it in."
                  },
                  "allowCustomLabel": {
                    "type": "boolean",
                    "description": "Whether people can give it their own label."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
