{
  "name": "updateCategoriesAdvanced",
  "displayName": "Update categories",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "throttable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API"
  ],
  "context": {
    "functionName": "updateCategoriesAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Changes several categories at once, up to 50.",
  "parameters": {
    "categories": {
      "type": "list",
      "displayName": "Categories",
      "required": true,
      "minValue": 1,
      "maxValue": 50,
      "description": "The categories to change and how, up to 50 at a time.",
      "items": {
        "categoryId": {
          "type": "string",
          "displayName": "Category id",
          "required": true,
          "description": "The category's id, as shown in search results.",
          "sampleValue": "[category id]"
        },
        "newTitle": {
          "type": "string",
          "displayName": "New category name",
          "required": false,
          "description": "The category's new name. Leave it out to keep the current one.",
          "sampleValue": "[new category name]"
        },
        "newIcon": {
          "type": "image",
          "displayName": "New picture",
          "required": false,
          "minValue": 1,
          "maxValue": 1,
          "description": "A new picture for the category, as a list holding one image; it replaces its font icon. Leave it out to keep the current icon.",
          "sampleValue": [
            "[image url]"
          ]
        },
        "newIconName": {
          "type": "string",
          "displayName": "New font icon",
          "required": false,
          "description": "A new font icon for the category, by its name; it replaces its picture. Leave it out to keep the current icon.",
          "sampleValue": "[icon name]"
        }
      },
      "sampleValue": [
        {
          "categoryId": "[category id]",
          "newTitle": "[new category name]"
        }
      ]
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when all the categories are done.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why nothing was changed, such as an unknown category or one listed twice."
        },
        "result": {
          "type": "object",
          "description": "How each category went.",
          "properties": {
            "categories": {
              "type": "array",
              "description": "One result per category, in the order they were given.",
              "items": {
                "type": "object",
                "description": "How one category went.",
                "properties": {
                  "index": {
                    "type": "number",
                    "description": "Which category this is, counting from 0."
                  },
                  "id": {
                    "type": "string",
                    "description": "The category's id, if it was changed."
                  },
                  "error": {
                    "type": "string",
                    "description": "Why it wasn't changed, if it wasn't."
                  }
                }
              }
            },
            "succeeded": {
              "type": "number",
              "description": "How many categories were changed."
            },
            "failed": {
              "type": "number",
              "description": "How many categories weren't changed."
            }
          }
        }
      }
    }
  }
}
