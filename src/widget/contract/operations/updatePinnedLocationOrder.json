{
  "name": "updatePinnedLocationOrder",
  "displayName": "Update pinned location order",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updatePinnedLocationOrderAdvanced",
      "label": "Advanced"
    }
  ],
  "context": {
    "functionName": "updatePinnedLocationOrder",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Rearranges the locations pinned to the top of the introduction screen.",
  "parameters": {
    "firstLocationTitle": {
      "type": "string",
      "displayName": "First location",
      "required": true,
      "description": "Exact title of the pinned location to show first.",
      "sampleValue": "[location title]"
    },
    "secondLocationTitle": {
      "type": "string",
      "displayName": "Second location",
      "required": false,
      "description": "Exact title of the pinned location to show second. Leave it out when only one location is pinned.",
      "sampleValue": "[location title]"
    },
    "thirdLocationTitle": {
      "type": "string",
      "displayName": "Third location",
      "required": false,
      "description": "Exact title of the pinned location to show third; needs the second. Leave it out when fewer than three are pinned.",
      "sampleValue": "[location title]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when it's done, with the pinned locations.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it didn't work, such as when the titles don't name exactly the locations pinned now, or a title matches nothing or several."
        },
        "result": {
          "type": "object",
          "description": "What was changed.",
          "properties": {
            "locations": {
              "type": "array",
              "description": "The pinned locations in their new order.",
              "items": {
                "type": "object",
                "description": "One location.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The location's id."
                  },
                  "title": {
                    "type": "string",
                    "description": "The location title."
                  },
                  "subtitle": {
                    "type": "string",
                    "description": "The subtitle, if it has one."
                  },
                  "address": {
                    "type": "string",
                    "description": "The street address."
                  },
                  "addressAlias": {
                    "type": "string",
                    "description": "The custom name shown in place of the address, if it has one."
                  },
                  "latitude": {
                    "type": "number",
                    "description": "The map pin's latitude."
                  },
                  "longitude": {
                    "type": "number",
                    "description": "The map pin's longitude."
                  },
                  "description": {
                    "type": "string",
                    "description": "The description, as HTML."
                  },
                  "listImage": {
                    "type": "string",
                    "description": "The list image URL."
                  },
                  "images": {
                    "type": "array",
                    "description": "The gallery image URLs, in order.",
                    "items": {
                      "type": "string",
                      "description": "One image URL."
                    }
                  },
                  "categoryTitles": {
                    "type": "array",
                    "description": "Titles of the live categories it is listed under.",
                    "items": {
                      "type": "string",
                      "description": "A category title."
                    }
                  },
                  "subcategoryTitles": {
                    "type": "array",
                    "description": "Titles of the live subcategories it is listed under.",
                    "items": {
                      "type": "string",
                      "description": "A subcategory title."
                    }
                  },
                  "priceRange": {
                    "type": "number",
                    "description": "The price range, 1 ($) to 4 ($$$$)."
                  },
                  "priceCurrency": {
                    "type": "string",
                    "description": "The currency sign."
                  },
                  "rating": {
                    "type": "number",
                    "description": "The average star rating app users gave it."
                  },
                  "ratingCount": {
                    "type": "number",
                    "description": "How many ratings it has."
                  },
                  "pinned": {
                    "type": "boolean",
                    "description": "Whether it is pinned to the top of the introduction screen."
                  },
                  "pinPosition": {
                    "type": "number",
                    "description": "Its pinned position, 1 to 3, if it is pinned."
                  },
                  "isOpenNow": {
                    "type": "boolean",
                    "description": "Whether it is open right now by its opening hours, using the clock of wherever the call runs."
                  },
                  "hours": {
                    "type": "object",
                    "description": "Opening hours per day, each \"HH:MM-HH:MM\" intervals separated by commas, or \"closed\".",
                    "properties": {
                      "monday": {
                        "type": "string",
                        "description": "Monday's hours."
                      },
                      "tuesday": {
                        "type": "string",
                        "description": "Tuesday's hours."
                      },
                      "wednesday": {
                        "type": "string",
                        "description": "Wednesday's hours."
                      },
                      "thursday": {
                        "type": "string",
                        "description": "Thursday's hours."
                      },
                      "friday": {
                        "type": "string",
                        "description": "Friday's hours."
                      },
                      "saturday": {
                        "type": "string",
                        "description": "Saturday's hours."
                      },
                      "sunday": {
                        "type": "string",
                        "description": "Sunday's hours."
                      }
                    }
                  },
                  "markerType": {
                    "type": "string",
                    "description": "pin, circle or image."
                  },
                  "actionItems": {
                    "type": "array",
                    "description": "The details page's buttons, as action items.",
                    "items": {
                      "type": "object",
                      "description": "One action item."
                    }
                  },
                  "fieldValues": {
                    "type": "array",
                    "description": "Location field values filled in for it.",
                    "items": {
                      "type": "object",
                      "description": "One field value.",
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "The location field's label."
                        },
                        "value": {
                          "type": "string",
                          "description": "The value."
                        },
                        "customLabel": {
                          "type": "string",
                          "description": "The label shown instead of the field's own, if it has one."
                        }
                      }
                    }
                  },
                  "subscriberCount": {
                    "type": "number",
                    "description": "How many app users follow it for updates."
                  },
                  "createdOn": {
                    "type": "datetime",
                    "description": "When it was created."
                  },
                  "lastUpdatedOn": {
                    "type": "datetime",
                    "description": "When it was last changed."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
