        "error": {
          "type": "object|string",
          "description": "Why it was not deleted, such as no location having that id."
        },
        "result": {
          "type": "object",
          "description": "The location that was deleted.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The location's id."
            },
            "title": {
              "type": "string",
              "description": "The location's title."
            }
          }
        }
      }
    }
  }
