{
  "name": "deleteCategory",
  "displayName": "Delete category",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "deleteCategoryAdvanced",
      "label": "Advanced"
    }
