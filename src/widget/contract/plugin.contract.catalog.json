    {
      "name": "searchLocations",
      "displayName": "Search locations",
      "type": "function",
      "crudMode": "read",
      "flags": [
        "immutable",
        "safe",
        "unthrottable"
      ],
      "usage": "basic",
      "availableFor": [
        "API",
        "form"
      ],
      "context": {
        "functionName": "searchLocations",
        "hosts": [
          "widgetBackground",
          "controlBackground",
          "headlessSdk"
        ]
      },
      "description": "Shows the locations in this plugin with their details, in alphabetical order or in pinned order.",
      "parameters": [
        "title",
        "search",
        "category",
        "pinnedOnly",
        "page",
        "pageSize"
      ],
      "definitionPath": "operations/searchLocations.json"
    },
    {
      "name": "searchCategories",
      "displayName": "Search categories",
      "type": "publicData",
      "crudMode": "read",
      "flags": [
        "immutable",
        "safe",
        "unthrottable"
      ],
      "usage": "basic",
      "availableFor": [
        "API",
        "form"
      ],
      "context": {
        "hosts": [
          "widgetBackground",
          "controlBackground",
          "headlessSdk"
        ],
        "collection": "categories",
        "operationType": "search",
        "scope": "app",
        "query": {
          "filter": {
            "_buildfire.index.date1": {
              "$type": 10
            },
            "$json.title": "$params.title"
          },
          "sort": {
            "_buildfire.index.string1": 1
          },
          "page": "$params.page",
          "pageSize": 50,
          "recordCount": true
        }
      },
      "description": "Shows the categories locations can be grouped in, with their subcategories, in alphabetical order, up to 50 at a time.",
      "parameters": [
        "title",
        "page"
      ],
      "definitionPath": "operations/searchCategories.json"
    },
