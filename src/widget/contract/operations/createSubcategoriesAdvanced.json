{
  "name": "createSubcategoriesAdvanced",
  "displayName": "Create subcategories",
  "type": "function",
  "crudMode": "create",
  "flags": [
    "mutable",
    "safe",
    "throttable"
  ],
  "usage": "advanced",
  "availableFor": [
    "API"
  ],
  "context": {
    "functionName": "createSubcategoriesAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Adds several subcategories at once.",
  "parameters": {
    "subcategories": {
      "type": "list",
      "displayName": "Subcategories",
      "required": true,
      "minValue": 1,
      "maxValue": 50,
      "items": {
        "categoryId": {
          "type": "string",
          "displayName": "Category id",
          "required": true,
          "description": "The category's id, as shown in category search results."
        },
        "title": {
          "type": "string",
          "displayName": "Subcategory title",
          "required": true,
          "description": "The new subcategory's title; one the category already has is refused."
        },
        "iconImage": {
          "type": "image",
          "displayName": "Icon",
          "required": false,
          "description": "The picture shown as the subcategory's icon. Leave it out to use the standard icon."
        }
      },
      "description": "The subcategories to add, up to 50 per call, each exactly as a single new subcategory would be.",
      "sampleValue": [
        {
          "categoryId": "[category id]",
          "title": "[subcategory title]"
        }
      ]
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when it's done, with each subcategory's outcome.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it didn't work, such as when any entry is invalid, does not resolve or repeats one, in which case nothing is added."
        },
        "result": {
          "type": "object",
          "description": "What was added.",
          "properties": {
            "subcategories": {
              "type": "array",
              "description": "One outcome per input entry, in input order.",
              "items": {
                "type": "object",
                "description": "One entry's outcome.",
                "properties": {
                  "index": {
                    "type": "number",
                    "description": "The entry's position in the input list, from 0."
                  },
                  "id": {
                    "type": "string",
                    "description": "The new subcategory's id, if it worked."
                  },
                  "error": {
                    "type": "string",
                    "description": "Why the entry failed, if it didn't."
                  }
                }
              }
            },
            "succeeded": {
              "type": "number",
              "description": "How many entries succeeded."
            },
            "failed": {
              "type": "number",
              "description": "How many entries failed."
            }
          }
        }
      }
    }
  }
}
