{
  "name": "updateSubcategoryOrder",
  "displayName": "Move subcategory",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "updateSubcategoryOrderAdvanced",
      "label": "Advanced"
    }
  ],
  "context": {
    "functionName": "updateSubcategoryOrder",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Moves a subcategory to a new place within its category, found by the category's and its own title.",
  "parameters": {
    "categoryTitle": {
      "type": "string",
      "displayName": "Category title",
      "required": true,
      "description": "The exact title of the category it belongs to.",
      "sampleValue": "[category title]"
    },
    "subcategoryTitle": {
      "type": "string",
      "displayName": "Subcategory title",
      "required": true,
      "description": "The exact title of the subcategory to move.",
      "sampleValue": "[subcategory title]"
    },
    "position": {
      "type": "number",
      "displayName": "Position",
      "required": true,
      "minValue": 1,
      "description": "Its new place among the category's subcategories, counting from 1.",
      "sampleValue": 1
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the subcategory is moved.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't moved, such as a place past the last one."
        },
        "result": {
          "type": "object",
          "description": "The category, with its subcategories in their new order.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The category's id."
            },
            "title": {
              "type": "string",
              "description": "The category's title."
            },
            "iconUrl": {
              "type": "string",
              "description": "The category's icon picture, if it has one."
            },
            "iconClassName": {
              "type": "string",
              "description": "The category's library icon, if it has one."
            },
            "subcategories": {
              "type": "array",
              "description": "Its subcategories, in order.",
              "items": {
                "type": "object",
                "description": "One subcategory.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The subcategory's id."
                  },
                  "title": {
                    "type": "string",
                    "description": "The subcategory's title."
                  },
                  "iconUrl": {
                    "type": "string",
                    "description": "The subcategory's icon picture, if it has one."
                  },
                  "iconClassName": {
                    "type": "string",
                    "description": "The subcategory's library icon, if it has one."
                  }
                }
              }
            },
            "createdOn": {
              "type": "datetime",
              "description": "When it was added."
            },
            "lastUpdatedOn": {
              "type": "datetime",
              "description": "When it was last changed."
            }
          }
        }
      }
    }
  }
}
