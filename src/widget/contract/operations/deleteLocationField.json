{
  "name": "deleteLocationField",
  "displayName": "Delete location field",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "dangerous",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "deleteLocationFieldAdvanced",
      "label": "Advanced"
    }
  ],
  "context": {
    "functionName": "deleteLocationField",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Permanently removes a location field, found by its label, from every location.",
  "parameters": {
    "label": {
      "type": "string",
      "displayName": "Field label",
      "required": true,
      "description": "The exact label of the field to remove.",
      "sampleValue": "[field label]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the field is removed.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't removed, such as no field or several having that label."
        },
        "result": {
          "type": "object",
          "description": "The field that was removed.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The field's id."
            },
            "label": {
              "type": "string",
              "description": "The field's label."
            }
          }
        }
      }
    }
  }
}
