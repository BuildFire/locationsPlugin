{
  "name": "createCategory",
  "displayName": "Create category",
  "type": "function",
  "crudMode": "create",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "createCategory",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Adds a category that locations can be sorted into.",
  "parameters": {
    "title": {
      "type": "string",
      "displayName": "Category name",
      "required": true,
      "description": "The category's name.",
      "sampleValue": "[category name]"
    },
    "icon": {
      "type": "image",
      "displayName": "Icon",
      "required": false,
      "minValue": 0,
      "maxValue": 1,
      "description": "The picture shown for it, as a list holding one image. Leave it out for none.",
      "sampleValue": [
        "[image url]"
      ]
    },
    "iconName": {
      "type": "string",
      "displayName": "Library icon",
      "required": false,
      "description": "An icon from the icon library, by its name, shown instead of a picture. Leave it out for none.",
      "sampleValue": "glyphicon glyphicon-cutlery"
    },
    "subcategories": {
      "type": "string",
      "displayName": "Subcategories",
      "required": false,
      "description": "The names of its subcategories, separated by commas. Leave it out for none.",
      "sampleValue": "[subcategory name], [subcategory name]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the category is added.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't added, such as a missing name."
        },
        "result": {
          "type": "object",
          "description": "The category, as it is now.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The category's id."
            },
            "title": {
              "type": "string",
              "description": "The category's name."
            },
            "iconUrl": {
              "type": "string",
              "description": "Its picture, if it has one."
            },
            "iconClassName": {
              "type": "string",
              "description": "Its icon from the icon library, if it has one."
            },
            "subcategories": {
              "type": "array",
              "description": "Its subcategories, in order.",
              "items": {
                "type": "object",
                "description": "One subcategory.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The subcategory's id."
                  },
                  "title": {
                    "type": "string",
                    "description": "The subcategory's name."
                  },
                  "iconUrl": {
                    "type": "string",
                    "description": "Its picture, if it has one."
                  },
                  "iconClassName": {
                    "type": "string",
                    "description": "Its icon from the icon library, if it has one."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
