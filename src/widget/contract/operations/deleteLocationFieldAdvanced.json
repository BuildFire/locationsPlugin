{
  "name": "deleteLocationFieldAdvanced",
  "displayName": "Delete location field",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "dangerous",
    "unthrottable"
  ],
  "usage": "advanced",
  "alternatives": [
    {
      "operationName": "deleteLocationField",
      "label": "Basic"
    }
  ],
  "availableFor": [
    "API",
    "form"
  ],
  "context": {
    "functionName": "deleteLocationFieldAdvanced",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Permanently removes an extra location field, so what was filled in for it no longer shows, using the field's id.",
  "parameters": {
    "fieldId": {
      "type": "string",
      "displayName": "Field id",
      "required": true,
      "description": "The field's id, as shown in the settings.",
      "sampleValue": "[field id]"
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the field is removed.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why it wasn't removed, such as no field having that id."
        },
        "result": {
          "type": "object",
          "description": "The field that was removed.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The field's id."
            },
            "label": {
              "type": "string",
              "description": "The field's name."
            },
            "section": {
              "type": "string",
              "description": "Where the field showed."
            },
            "deleted": {
              "type": "boolean",
              "description": "Always yes once it is removed."
            }
          }
        }
      }
    }
  }
}
