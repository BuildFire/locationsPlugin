{
  "name": "updateSettings",
  "displayName": "Update settings",
  "type": "function",
  "crudMode": "update",
  "flags": [
    "mutable",
    "safe",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API"
  ],
  "context": {
    "functionName": "updateSettings",
    "hosts": [
      "controlBackground",
      "headlessSdk"
    ]
  },
  "description": "Changes the plugin's settings, design or introduction screen; only the settings given change.",
  "parameters": {
    "subscriptionEnabled": {
      "type": "boolean",
      "displayName": "Enable locations subscribing",
      "required": false,
      "description": "Whether people can subscribe to updates about a location. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "measurementUnit": {
      "type": "select",
      "displayName": "Distance units",
      "required": false,
      "description": "The units distances are shown in. Leave it out to keep the current choice.",
      "enums": [
        {
          "label": "Metric",
          "value": "metric"
        },
        {
          "label": "Imperial",
          "value": "imperial"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "imperial"
    },
    "initialArea": {
      "type": "boolean",
      "displayName": "Enable map initial area",
      "required": false,
      "description": "Whether the map starts on a chosen area. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "initialAreaAddress": {
      "type": "string",
      "displayName": "Initial area location",
      "required": false,
      "description": "The address the map starts on, given with its latitude and longitude. Leave it out to keep the current one.",
      "sampleValue": "San Diego, CA, USA"
    },
    "initialAreaLatitude": {
      "type": "number",
      "displayName": "Initial area latitude",
      "required": false,
      "minValue": -90,
      "maxValue": 90,
      "description": "The starting address's latitude. Leave it out to keep the current one.",
      "sampleValue": 32.7157
    },
    "initialAreaLongitude": {
      "type": "number",
      "displayName": "Initial area longitude",
      "required": false,
      "minValue": -180,
      "maxValue": 180,
      "description": "The starting address's longitude. Leave it out to keep the current one.",
      "sampleValue": -117.1611
    },
    "defaultSorting": {
      "type": "select",
      "displayName": "Default sorting",
      "required": false,
      "description": "The sort people see first; distance needs nearest first to be offered. Leave it out to keep the current choice.",
      "enums": [
        {
          "label": "Distance",
          "value": "distance"
        },
        {
          "label": "Alphabetical",
          "value": "alphabetical"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "alphabetical"
    },
    "hideSorting": {
      "type": "boolean",
      "displayName": "Hide user controlled sorting",
      "required": false,
      "description": "Whether sorting is hidden from people. Leave it out to keep the current choice.",
      "sampleValue": false
    },
    "allowSortByReverseAlphabetical": {
      "type": "boolean",
      "displayName": "Allow reverse alphabetical order",
      "required": false,
      "description": "Whether reverse alphabetical order is offered. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "allowSortByNearest": {
      "type": "boolean",
      "displayName": "Nearest to user location",
      "required": false,
      "description": "Whether nearest first is offered; turning it off makes alphabetical the sort people see first. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "allowSortByPriceLowToHigh": {
      "type": "boolean",
      "displayName": "Allow price low to high",
      "required": false,
      "description": "Whether price low to high is offered. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "allowSortByPriceHighToLow": {
      "type": "boolean",
      "displayName": "Allow price high to low",
      "required": false,
      "description": "Whether price high to low is offered. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "allowSortByDate": {
      "type": "boolean",
      "displayName": "Allow by date (new to old)",
      "required": false,
      "description": "Whether newest first is offered. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "allowSortByRating": {
      "type": "boolean",
      "displayName": "Allow by rating",
      "required": false,
      "description": "Whether sorting by rating is offered. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "allowSortByViews": {
      "type": "boolean",
      "displayName": "Allow by views",
      "required": false,
      "description": "Whether sorting by views is offered. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "allowFilterByArea": {
      "type": "boolean",
      "displayName": "Filter by selected area",
      "required": false,
      "description": "Whether filtering by the selected area is offered. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "allowFilterByBookmarks": {
      "type": "boolean",
      "displayName": "Filter by bookmarks",
      "required": false,
      "description": "Whether filtering by bookmarks is offered. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "hideOpeningHoursFilter": {
      "type": "boolean",
      "displayName": "Hide opening hours filter",
      "required": false,
      "description": "Whether the opening hours filter is hidden. Leave it out to keep the current choice.",
      "sampleValue": false
    },
    "hidePriceFilter": {
      "type": "boolean",
      "displayName": "Hide price filter",
      "required": false,
      "description": "Whether the price filter is hidden. Leave it out to keep the current choice.",
      "sampleValue": false
    },
    "bookmarksEnabled": {
      "type": "boolean",
      "displayName": "Bookmarks",
      "required": false,
      "description": "Whether bookmarks are on. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "allowBookmarkLocations": {
      "type": "boolean",
      "displayName": "Allow bookmark location",
      "required": false,
      "description": "Whether people can bookmark locations. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "allowBookmarkSearch": {
      "type": "boolean",
      "displayName": "Allow bookmark search",
      "required": false,
      "description": "Whether people can bookmark searches. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "openHoursEnabled": {
      "type": "boolean",
      "displayName": "Open hours",
      "required": false,
      "description": "Whether locations have opening hours; turning it off also stops people adding them in the app. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "priceRangeEnabled": {
      "type": "boolean",
      "displayName": "Price range",
      "required": false,
      "description": "Whether locations have a price range; turning it off also stops people adding it in the app. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "paymentDetails": {
      "type": "wysiwyg",
      "displayName": "Payment details",
      "required": false,
      "nullable": true,
      "description": "The payment details shown to people who pay to add a location. Leave it out to keep them, or leave it empty to remove them.",
      "sampleValue": "<p>[payment details]</p>"
    },
    "timeFormat": {
      "type": "select",
      "displayName": "Time",
      "required": false,
      "description": "The time format used when adding or editing a location. Leave it out to keep the current choice.",
      "enums": [
        {
          "label": "12 hours format",
          "value": "12H"
        },
        {
          "label": "24 hours format",
          "value": "24H"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "24H"
    },
    "listViewPosition": {
      "type": "select",
      "displayName": "List view position",
      "required": false,
      "description": "Where the list starts. Leave it out to keep the current choice.",
      "enums": [
        {
          "label": "Expanded",
          "value": "expanded"
        },
        {
          "label": "Collapsed",
          "value": "collapsed"
        },
        {
          "label": "Half expanded",
          "value": "halfExpanded"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "halfExpanded"
    },
    "listViewStyle": {
      "type": "select",
      "displayName": "List view style",
      "required": false,
      "description": "How list items look. Leave it out to keep the current choice.",
      "enums": [
        {
          "label": "Background image",
          "value": "backgroundImage"
        },
        {
          "label": "Small image",
          "value": "smallImage"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "smallImage"
    },
    "mapType": {
      "type": "select",
      "displayName": "Default map type",
      "required": false,
      "description": "The map type people see first. Leave it out to keep the current choice.",
      "enums": [
        {
          "label": "Streets",
          "value": "streets"
        },
        {
          "label": "Satellite",
          "value": "satellite"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "satellite"
    },
    "detailsMapPosition": {
      "type": "select",
      "displayName": "Map position",
      "required": false,
      "description": "Where the map sits on a location page. Leave it out to keep the current choice.",
      "enums": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "bottom"
    },
    "enableMapTerrainView": {
      "type": "boolean",
      "displayName": "Enable map terrain view",
      "required": false,
      "description": "Whether the terrain view is on. Leave it out to keep the current choice.",
      "sampleValue": false
    },
    "hideQuickFilter": {
      "type": "boolean",
      "displayName": "Hide quick filter",
      "required": false,
      "description": "Whether the quick filter is hidden. Leave it out to keep the current choice.",
      "sampleValue": false
    },
    "allowStyleSelection": {
      "type": "boolean",
      "displayName": "Allow map style selection",
      "required": false,
      "description": "Whether people can pick the map style. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "showDetailsCategory": {
      "type": "boolean",
      "displayName": "Show category on location details",
      "required": false,
      "description": "Whether categories show on a location page. Leave it out to keep the current choice.",
      "sampleValue": true
    },
    "showContributorName": {
      "type": "boolean",
      "displayName": "Show contributor name",
      "required": false,
      "description": "Whether the name of the person who added a location is shown. Leave it out to keep the current choice.",
      "sampleValue": false
    },
    "introImages": {
      "type": "action",
      "displayName": "Introduction pictures",
      "required": false,
      "nullable": true,
      "minValue": 0,
      "description": "The pictures at the top of the introduction screen, in order, each with what happens when it is tapped; they replace the current ones. Leave it out to keep them, or pass an empty list to remove them.",
      "sampleValue": [
        {
          "title": "Welcome",
          "action": "noAction",
          "iconUrl": "https://example.com/welcome.png"
        }
      ]
    },
    "introDescription": {
      "type": "wysiwyg",
      "displayName": "Introduction text",
      "required": false,
      "nullable": true,
      "description": "The text below the introduction pictures. Leave it out to keep it, or leave it empty to remove it.",
      "sampleValue": "<p>[introduction text]</p>"
    },
    "introSorting": {
      "type": "select",
      "displayName": "Sort locations by",
      "required": false,
      "description": "How the introduction screen sorts its locations. Leave it out to keep the current choice.",
      "enums": [
        {
          "label": "Distance",
          "value": "distance"
        },
        {
          "label": "Alphabetical",
          "value": "alphabetical"
        },
        {
          "label": "Newest",
          "value": "newest"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "newest"
    },
    "introLocationSource": {
      "type": "select",
      "displayName": "Location source",
      "required": false,
      "description": "Which locations the introduction screen lists. Leave it out to keep the current choice.",
      "enums": [
        {
          "label": "All Locations",
          "value": "All"
        },
        {
          "label": "User's Position",
          "value": "UserPosition"
        },
        {
          "label": "Local Area",
          "value": "AreaRadius"
        },
        {
          "label": "My Locations",
          "value": "MyLocations"
        }
      ],
      "allowEnumCustomOption": false,
      "sampleValue": "AreaRadius"
    },
    "introAreaAddress": {
      "type": "string",
      "displayName": "Area center",
      "required": false,
      "description": "The local area's center address, given with its latitude and longitude. Leave it out to keep the current one.",
      "sampleValue": "San Diego, CA, USA"
    },
    "introAreaLatitude": {
      "type": "number",
      "displayName": "Area center latitude",
      "required": false,
      "minValue": -90,
      "maxValue": 90,
      "description": "The center's latitude. Leave it out to keep the current one.",
      "sampleValue": 32.7157
    },
    "introAreaLongitude": {
      "type": "number",
      "displayName": "Area center longitude",
      "required": false,
      "minValue": -180,
      "maxValue": 180,
      "description": "The center's longitude. Leave it out to keep the current one.",
      "sampleValue": -117.1611
    },
    "introAreaRadius": {
      "type": "number",
      "displayName": "Area radius (miles)",
      "required": false,
      "minValue": 1,
      "maxValue": 200,
      "description": "The local area's radius in miles. Leave it out to keep the current one.",
      "sampleValue": 25
    },
    "callback": {
      "type": "function",
      "required": true,
      "description": "Runs when the settings are saved.",
      "parameters": {
        "error": {
          "type": "object|string",
          "description": "Why they weren't saved, such as nothing to change or distance sorting while nearest first is off."
        },
        "result": {
          "type": "object",
          "description": "The saved settings.",
          "properties": {
            "subscription": {
              "type": "object",
              "description": "Whether people can subscribe to updates about a location.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether subscribing is on."
                }
              }
            },
            "measurementUnit": {
              "type": "string",
              "description": "The distance units: metric or imperial."
            },
            "introductoryListView": {
              "type": "object",
              "description": "The introduction screen.",
              "properties": {
                "images": {
                  "type": "array",
                  "description": "The pictures at the top of the screen, each with what happens when it is tapped.",
                  "items": {
                    "type": "object",
                    "description": "One picture.",
                    "properties": {
                      "iconUrl": {
                        "type": "string",
                        "description": "The picture."
                      },
                      "action": {
                        "type": "string",
                        "description": "What happens when it is tapped."
                      }
                    }
                  }
                },
                "description": {
                  "type": "string",
                  "description": "The text below the pictures, as formatted text."
                },
                "sorting": {
                  "type": "string",
                  "description": "How its locations are sorted: distance, alphabetical or newest."
                },
                "searchOptions": {
                  "type": "object",
                  "description": "Which locations it lists.",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "description": "Which locations it lists: All, UserPosition, AreaRadius or MyLocations."
                    },
                    "areaRadiusOptions": {
                      "type": "object",
                      "description": "The local area, when only a local area is listed.",
                      "properties": {
                        "formattedLocation": {
                          "type": "string",
                          "description": "The area's center address."
                        },
                        "lat": {
                          "type": "number",
                          "description": "The center's latitude."
                        },
                        "lng": {
                          "type": "number",
                          "description": "The center's longitude."
                        },
                        "radius": {
                          "type": "number",
                          "description": "The radius, in miles."
                        }
                      }
                    }
                  }
                }
              }
            },
            "sorting": {
              "type": "object",
              "description": "How people can sort locations.",
              "properties": {
                "defaultSorting": {
                  "type": "string",
                  "description": "The sort used at first: distance or alphabetical."
                },
                "hideSorting": {
                  "type": "boolean",
                  "description": "Whether sorting is hidden from people."
                },
                "allowSortByReverseAlphabetical": {
                  "type": "boolean",
                  "description": "Whether reverse alphabetical order is offered."
                },
                "allowSortByNearest": {
                  "type": "boolean",
                  "description": "Whether nearest first is offered."
                },
                "allowSortByPriceLowToHigh": {
                  "type": "boolean",
                  "description": "Whether price low to high is offered."
                },
                "allowSortByPriceHighToLow": {
                  "type": "boolean",
                  "description": "Whether price high to low is offered."
                },
                "allowSortByDate": {
                  "type": "boolean",
                  "description": "Whether newest first is offered."
                },
                "allowSortByRating": {
                  "type": "boolean",
                  "description": "Whether by rating is offered."
                },
                "allowSortByViews": {
                  "type": "boolean",
                  "description": "Whether by views is offered."
                }
              }
            },
            "filter": {
              "type": "object",
              "description": "Which filters people can use.",
              "properties": {
                "allowFilterByArea": {
                  "type": "boolean",
                  "description": "Whether filtering by the selected area is offered."
                },
                "allowFilterByBookmarks": {
                  "type": "boolean",
                  "description": "Whether filtering by bookmarks is offered."
                },
                "hideOpeningHoursFilter": {
                  "type": "boolean",
                  "description": "Whether the opening hours filter is hidden."
                },
                "hidePriceFilter": {
                  "type": "boolean",
                  "description": "Whether the price filter is hidden."
                }
              }
            },
            "map": {
              "type": "object",
              "description": "The map.",
              "properties": {
                "initialArea": {
                  "type": "boolean",
                  "description": "Whether the map starts on a chosen area."
                },
                "initialAreaCoordinates": {
                  "type": "object",
                  "description": "The chosen area's center.",
                  "properties": {
                    "lat": {
                      "type": "number",
                      "description": "Its latitude."
                    },
                    "lng": {
                      "type": "number",
                      "description": "Its longitude."
                    }
                  }
                },
                "initialAreaDisplayAddress": {
                  "type": "string",
                  "description": "The chosen area's address."
                }
              }
            },
            "bookmarks": {
              "type": "object",
              "description": "Bookmarks.",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether bookmarks are on."
                },
                "allowForLocations": {
                  "type": "boolean",
                  "description": "Whether people can bookmark locations."
                },
                "allowForFilters": {
                  "type": "boolean",
                  "description": "Whether people can bookmark searches."
                }
              }
            },
            "customFields": {
              "type": "object",
              "description": "The location fields every location can fill in.",
              "properties": {
                "quickActions": {
                  "type": "array",
                  "description": "The quick action fields, in order.",
                  "items": {
                    "type": "object",
                    "description": "One field.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The field's id."
                      },
                      "group": {
                        "type": "string",
                        "description": "Where the field is shown: quickActions or content."
                      },
                      "label": {
                        "type": "string",
                        "description": "The field's label."
                      },
                      "type": {
                        "type": "string",
                        "description": "The kind of value the field takes."
                      },
                      "required": {
                        "type": "boolean",
                        "description": "Whether a value is required."
                      },
                      "allowCustomLabel": {
                        "type": "boolean",
                        "description": "Whether each location may give its own label."
                      }
                    }
                  }
                },
                "content": {
                  "type": "array",
                  "description": "The text content fields, in order.",
                  "items": {
                    "type": "object",
                    "description": "One field.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The field's id."
                      },
                      "group": {
                        "type": "string",
                        "description": "Where the field is shown: quickActions or content."
                      },
                      "label": {
                        "type": "string",
                        "description": "The field's label."
                      },
                      "type": {
                        "type": "string",
                        "description": "The kind of value the field takes."
                      },
                      "required": {
                        "type": "boolean",
                        "description": "Whether a value is required."
                      },
                      "allowCustomLabel": {
                        "type": "boolean",
                        "description": "Whether each location may give its own label."
                      }
                    }
                  }
                }
              }
            },
            "design": {
              "type": "object",
              "description": "The look of the plugin.",
              "properties": {
                "listViewPosition": {
                  "type": "string",
                  "description": "Where the list starts: expanded, collapsed or halfExpanded."
                },
                "listViewStyle": {
                  "type": "string",
                  "description": "How list items look: backgroundImage or smallImage."
                },
                "defaultMapType": {
                  "type": "string",
                  "description": "The map type: streets or satellite."
                },
                "detailsMapPosition": {
                  "type": "string",
                  "description": "Where the map sits on a location page: top or bottom."
                },
                "enableMapTerrainView": {
                  "type": "boolean",
                  "description": "Whether the terrain view is on."
                },
                "hideQuickFilter": {
                  "type": "boolean",
                  "description": "Whether the quick filter is hidden."
                },
                "allowStyleSelection": {
                  "type": "boolean",
                  "description": "Whether people can pick the map style."
                },
                "showDetailsCategory": {
                  "type": "boolean",
                  "description": "Whether categories show on a location page."
                },
                "showContributorName": {
                  "type": "boolean",
                  "description": "Whether the name of the person who added a location is shown."
                }
              }
            },
            "globalEntries": {
              "type": "object",
              "description": "Which location details are offered.",
              "properties": {
                "openHours": {
                  "type": "object",
                  "description": "Opening hours.",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "Whether locations have opening hours."
                    }
                  }
                },
                "priceRange": {
                  "type": "object",
                  "description": "Price range.",
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "description": "Whether locations have a price range."
                    }
                  }
                },
                "charging": {
                  "type": "object",
                  "description": "Charging for adding locations.",
                  "properties": {
                    "description": {
                      "type": "string",
                      "description": "The payment details shown, as formatted text."
                    }
                  }
                }
              }
            },
            "locationEditors": {
              "type": "object",
              "description": "Location editing.",
              "properties": {
                "time": {
                  "type": "string",
                  "description": "The time format: 12H or 24H."
                }
              }
            }
          }
        }
      }
    }
  }
}
