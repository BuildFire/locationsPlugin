{
  "name": "deleteLocation",
  "displayName": "Delete location",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "dangerous",
    "unthrottable"
  ],
  "usage": "basic",
  "availableFor": [
    "API",
    "form"
  ],
  "alternatives": [
    {
      "operationName": "deleteLocationAdvanced",
      "label": "Advanced"
    }
  ],
  "context": {
    "functionName": "deleteLocation",
    "hosts": [
      "widgetBackground",
      "controlBackground",
      "headlessSdk"
    ]
  },
